<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VKRMed — VKR Global</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<style>
/* ── TOKENS ── */
:root {
  --navy: #0B1F3A;
  --navy-mid: #122847;
  --navy-light: #1A3A5C;
  --teal: #0D7A6B;
  --teal-light: #0F9B89;
  --teal-pale: #E4F4F2;
  --gold: #C9A84C;
  --gold-pale: #FBF5E6;
  --gold-mid: #E8C96A;
  --white: #FFFFFF;
  --off-white: #F8F9FA;
  --slate: #F1F4F7;
  --text-primary: #0B1F3A;
  --text-secondary: #4A5568;
  --text-muted: #718096;
  --border: #E2E8F0;
  --border-strong: #CBD5E0;
  --danger: #C0392B;
  --danger-pale: #FEF2F2;
  --warn: #92610A;
  --warn-pale: #FFFBEB;
  --success: #166534;
  --success-pale: #F0FDF4;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --shadow-sm: 0 1px 3px rgba(11,31,58,.08), 0 1px 2px rgba(11,31,58,.04);
  --shadow-md: 0 4px 12px rgba(11,31,58,.10), 0 2px 4px rgba(11,31,58,.06);
  --shadow-lg: 0 12px 32px rgba(11,31,58,.14), 0 4px 8px rgba(11,31,58,.08);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--off-white);
  color: var(--text-primary);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── HEADER ── */
.site-header {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 60%, var(--teal) 100%);
  padding: 18px 28px 0;
  position: relative;
  overflow: hidden;
}
.site-header::before {
  content: '';
  position: absolute;
  top: -40px; right: -40px;
  width: 220px; height: 220px;
  border-radius: 50%;
  background: rgba(13,122,107,.15);
  pointer-events: none;
}
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}
.brand-mark {
  width: 36px; height: 36px;
  background: var(--gold);
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: 16px; font-weight: 500;
  color: var(--navy);
  letter-spacing: -.5px;
  flex-shrink: 0;
}
.brand-text { line-height: 1.1; }
.brand-name {
  font-size: 14px; font-weight: 600;
  color: var(--white);
  letter-spacing: .02em;
}
.brand-sub {
  font-size: 10px; font-weight: 400;
  color: rgba(255,255,255,.55);
  letter-spacing: .06em;
  text-transform: uppercase;
}
.header-badge {
  font-size: 10px; font-weight: 500;
  color: var(--gold);
  border: 1px solid rgba(201,168,76,.4);
  border-radius: 20px;
  padding: 3px 10px;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.product-hero {
  padding-bottom: 22px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.product-eyebrow {
  font-size: 10px; font-weight: 600;
  color: var(--gold);
  letter-spacing: .1em;
  text-transform: uppercase;
  margin-bottom: 6px;
}
.product-name {
  font-family: 'Playfair Display', serif;
  font-size: 28px; font-weight: 400;
  color: var(--white);
  line-height: 1.15;
  margin-bottom: 8px;
}
.product-name span { color: var(--gold-mid); font-style: italic; }
.product-desc {
  font-size: 13px; font-weight: 300;
  color: rgba(255,255,255,.7);
  line-height: 1.6;
  max-width: 520px;
}
.gold-rule {
  height: 2px;
  background: linear-gradient(90deg, var(--gold) 0%, var(--gold-mid) 40%, transparent 100%);
  width: 60px;
  border-radius: 1px;
  margin: 12px 0;
}

.persona-tabs {
  display: flex;
  gap: 2px;
  padding-top: 16px;
}
.ptab {
  padding: 9px 16px;
  font-size: 12px; font-weight: 500;
  color: rgba(255,255,255,.55);
  border-bottom: 2px solid transparent;
  cursor: pointer;
  transition: all .2s;
  background: none; border-top: none; border-left: none; border-right: none;
  letter-spacing: .01em;
  white-space: nowrap;
}
.ptab:hover { color: rgba(255,255,255,.8); }
.ptab.active { color: var(--white); border-bottom-color: var(--gold); }

/* ── MAIN CONTENT ── */
.main { padding: 24px 28px; max-width: 760px; }

.screen { display: none; }
.screen.active { display: block; }

/* Step indicator */
.step-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 20px;
}
.step-node {
  width: 26px; height: 26px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600;
  flex-shrink: 0;
  transition: all .2s;
}
.step-node.done { background: var(--teal); color: var(--white); }
.step-node.active { background: var(--navy); color: var(--white); box-shadow: 0 0 0 3px rgba(13,122,107,.2); }
.step-node.idle { background: var(--border); color: var(--text-muted); }
.step-connector { flex: 1; height: 1px; background: var(--border); }
.step-connector.done { background: var(--teal); }
.step-label { font-size: 12px; color: var(--text-muted); margin-left: 4px; }

/* Geo grid */
.geo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 8px;
  margin-bottom: 16px;
}
.g-btn {
  display: flex; align-items: center; gap: 8px;
  padding: 9px 12px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-size: 13px; font-weight: 400;
  color: var(--text-primary);
  cursor: pointer;
  transition: all .15s;
  text-align: left;
}
.g-btn:hover { border-color: var(--teal); background: var(--teal-pale); }
.g-btn.sel { border-color: var(--teal); background: var(--teal-pale); color: var(--teal); font-weight: 500; }
.g-flag { font-size: 18px; line-height: 1; }

/* Profile row */
.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
  margin-bottom: 4px;
}
.field-group label {
  display: block;
  font-size: 11px; font-weight: 500;
  color: var(--text-muted);
  letter-spacing: .04em;
  text-transform: uppercase;
  margin-bottom: 5px;
}
.field-group input,
.field-group select {
  width: 100%;
  padding: 8px 10px;
  font-size: 13px;
  font-family: 'Inter', sans-serif;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--white);
  color: var(--text-primary);
  transition: border-color .15s;
}
.field-group input:focus, .field-group select:focus {
  outline: none; border-color: var(--teal);
}

/* Symptom grid */
.sym-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
  gap: 7px;
  margin-bottom: 14px;
}
.sym-btn {
  display: flex; align-items: center; gap: 7px;
  padding: 8px 11px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-size: 13px;
  color: var(--text-primary);
  cursor: pointer;
  text-align: left;
  transition: all .15s;
}
.sym-btn i { font-size: 15px; color: var(--text-muted); transition: color .15s; }
.sym-btn:hover { border-color: var(--teal); background: var(--teal-pale); }
.sym-btn:hover i { color: var(--teal); }
.sym-btn.sel { border-color: var(--teal); background: var(--teal-pale); color: var(--teal); font-weight: 500; }
.sym-btn.sel i { color: var(--teal); }

textarea.desc-input {
  width: 100%;
  padding: 10px 13px;
  font-size: 13px;
  font-family: 'Inter', sans-serif;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--white);
  color: var(--text-primary);
  resize: vertical;
  line-height: 1.5;
}
textarea.desc-input:focus { outline: none; border-color: var(--teal); }
textarea.desc-input::placeholder { color: var(--text-muted); }

/* Buttons */
.btn-primary {
  background: var(--teal);
  color: var(--white);
  border: none;
  border-radius: var(--radius-md);
  padding: 10px 22px;
  font-size: 13px; font-weight: 500;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  transition: background .15s, transform .1s;
  letter-spacing: .01em;
}
.btn-primary:hover { background: var(--teal-light); }
.btn-primary:active { transform: scale(.98); }
.btn-primary:disabled { background: var(--border-strong); cursor: not-allowed; }

.btn-secondary {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-md);
  padding: 10px 18px;
  font-size: 13px;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  transition: all .15s;
}
.btn-secondary:hover { background: var(--slate); color: var(--text-primary); }

.btn-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 18px; }

.btn-gold {
  background: var(--gold);
  color: var(--navy);
  border: none;
  border-radius: var(--radius-md);
  padding: 10px 22px;
  font-size: 13px; font-weight: 600;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  transition: all .15s;
  letter-spacing: .01em;
}
.btn-gold:hover { background: var(--gold-mid); }

/* Section labels */
.sec-lbl {
  font-size: 11px; font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8px;
}
.sec-lbl.gold { color: var(--gold); }

h3.screen-title {
  font-size: 17px; font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 5px;
}
p.screen-sub {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.55;
  margin-bottom: 16px;
}

/* Chips */
.chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 14px; }
.chip {
  font-size: 11px; font-weight: 500;
  padding: 3px 9px;
  border-radius: 20px;
}
.chip.persona { background: rgba(13,122,107,.1); color: var(--teal); }
.chip.geo { background: var(--gold-pale); color: #7A5D1A; }
.chip.sym { background: var(--slate); color: var(--text-secondary); }
.chip.profile { background: rgba(11,31,58,.07); color: var(--navy); }

/* Progress bar */
.prog-wrap {
  height: 3px;
  background: var(--border);
  border-radius: 2px;
  margin-bottom: 16px;
  overflow: hidden;
}
.prog-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--teal), var(--teal-light));
  border-radius: 2px;
  transition: width .35s ease;
}

/* Q card */
.q-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12px;
}
.q-num { font-size: 11px; color: var(--text-muted); margin-bottom: 7px; font-weight: 500; }
.q-text { font-size: 15px; font-weight: 500; margin-bottom: 14px; line-height: 1.4; color: var(--text-primary); }
.q-opts { display: flex; flex-direction: column; gap: 6px; }
.q-opt {
  padding: 9px 14px;
  background: var(--off-white);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  text-align: left;
  color: var(--text-primary);
  transition: all .15s;
}
.q-opt:hover { border-color: var(--teal); background: var(--teal-pale); color: var(--teal); }
.q-opt.answered { border-color: var(--teal); background: var(--teal-pale); color: var(--teal); font-weight: 500; }

/* Loading */
.loading-wrap { padding: 28px 0; }
.loading-label { font-size: 13px; color: var(--text-secondary); margin-bottom: 12px; }
.progress-anim {
  height: 3px;
  background: var(--border);
  border-radius: 2px;
  overflow: hidden;
  width: 200px;
}
.progress-anim-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--teal), var(--gold));
  border-radius: 2px;
  animation: progslide 1.6s ease-in-out infinite;
}
@keyframes progslide { 0%{transform:translateX(-100%)} 100%{transform:translateX(300%)} }
@keyframes spin { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
.load-step { display:flex; align-items:center; gap:8px; font-size:12px; color:var(--text-muted); opacity:0; animation:fadeStep .4s ease forwards; }
.load-step i { font-size:14px; }
.load-step.done { color:var(--teal); }
@keyframes fadeStep { from{opacity:0;transform:translateX(-6px)} to{opacity:1;transform:translateX(0)} }

/* Urgency banner */
.urgency-banner {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 12px 15px;
  border-radius: var(--radius-md);
  font-size: 13px;
  line-height: 1.5;
  margin-bottom: 14px;
}
.urgency-banner i { font-size: 17px; flex-shrink: 0; margin-top: 1px; }
.urgency-banner.red { background: var(--danger-pale); color: var(--danger); border: 1px solid #FECACA; }
.urgency-banner.amber { background: var(--warn-pale); color: var(--warn); border: 1px solid #FDE68A; }
.urgency-banner.green { background: var(--success-pale); color: var(--success); border: 1px solid #BBF7D0; }

/* Result cards */
.result-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px 18px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 10px;
}
.result-card:hover { box-shadow: var(--shadow-md); transition: box-shadow .2s; }
.rc-head { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
.rc-icon {
  width: 32px; height: 32px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0;
}
.rc-icon.info { background: #EFF6FF; color: #1D4ED8; }
.rc-icon.warn { background: var(--warn-pale); color: var(--warn); }
.rc-icon.danger { background: var(--danger-pale); color: var(--danger); }
.rc-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
.rc-likelihood { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
.icd-badge {
  display: inline-block;
  font-size: 10px; font-weight: 600;
  background: rgba(11,31,58,.07);
  color: var(--navy);
  padding: 2px 6px; border-radius: 4px;
  margin-left: 6px; vertical-align: middle;
}
.rc-body {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 10px;
}
.tags { display: flex; flex-wrap: wrap; gap: 5px; }
.tag { font-size: 11px; padding: 3px 9px; border-radius: 20px; font-weight: 500; }
.tag.g { background: var(--success-pale); color: var(--success); }
.tag.a { background: var(--warn-pale); color: var(--warn); }
.tag.r { background: var(--danger-pale); color: var(--danger); }
.ref-line {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--border);
  line-height: 1.4;
}
.pubmed-link {
  display: inline-flex; align-items: center; gap: 4px;
  margin-top: 6px;
  font-size: 11px; font-weight: 500;
  color: var(--teal);
  background: var(--teal-pale);
  border: 1px solid rgba(13,122,107,.2);
  border-radius: 20px;
  padding: 3px 10px;
  cursor: pointer;
  text-decoration: none;
  transition: all .15s;
}
.pubmed-link:hover { background: var(--teal); color: var(--white); }

/* Advice box */
.advice-box {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
  border-radius: var(--radius-lg);
  padding: 16px 18px;
  margin: 14px 0;
}
.advice-box .advice-label {
  font-size: 10px; font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 6px;
}
.advice-box .advice-text {
  font-size: 13px;
  color: rgba(255,255,255,.85);
  line-height: 1.65;
}

/* Research panel */
.research-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 14px 0;
}
.rp-header {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 16px;
  background: linear-gradient(90deg, var(--navy) 0%, var(--navy-mid) 100%);
}
.rp-header-title { font-size: 13px; font-weight: 500; color: var(--white); }
.rp-header-sub { font-size: 11px; color: rgba(255,255,255,.5); margin-left: auto; }
.rp-body { padding: 14px 16px; background: var(--white); }
.research-item {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
}
.research-item:last-of-type { border-bottom: none; }
.ri-icon {
  width: 28px; height: 28px;
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; flex-shrink: 0; margin-top: 1px;
}
.ri-icon.pm { background: #EFF6FF; color: #1D4ED8; }
.ri-icon.mx { background: #F5F3FF; color: #6D28D9; }
.ri-icon.cr { background: var(--success-pale); color: var(--success); }
.ri-title {
  font-size: 13px; font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 3px;
  cursor: pointer;
  transition: color .15s;
}
.ri-title:hover { color: var(--teal); }
.ri-desc { font-size: 12px; color: var(--text-muted); line-height: 1.4; margin-bottom: 6px; }
.ri-links { display: flex; flex-wrap: wrap; gap: 5px; }
.ri-link {
  display: inline-flex; align-items: center; gap: 3px;
  font-size: 11px; font-weight: 500;
  padding: 3px 9px; border-radius: 20px;
  cursor: pointer;
  transition: all .15s;
  border: 1px solid var(--border);
  color: var(--text-secondary);
  background: var(--off-white);
}
.ri-link:hover { border-color: var(--teal); color: var(--teal); background: var(--teal-pale); }

.contribute-strip {
  background: var(--gold-pale);
  border: 1px solid rgba(201,168,76,.25);
  border-radius: var(--radius-md);
  padding: 11px 14px;
  font-size: 12px;
  color: #7A5D1A;
  line-height: 1.55;
  margin-top: 10px;
}
.contribute-strip strong { font-weight: 600; }
.contribute-strip a { color: var(--teal); text-decoration: none; font-weight: 500; }
.contribute-strip a:hover { text-decoration: underline; }

/* Resources */
.resource-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  margin-top: 8px;
}
.res-card {
  display: flex; align-items: center; gap: 9px;
  padding: 9px 12px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all .15s;
}
.res-card:hover { border-color: var(--teal); background: var(--teal-pale); }
.res-card i { font-size: 16px; color: var(--text-muted); flex-shrink: 0; }
.res-card:hover i { color: var(--teal); }
.res-name { font-size: 12px; font-weight: 500; color: var(--text-primary); }
.res-desc { font-size: 11px; color: var(--text-muted); }
.res-arrow { margin-left: auto; font-size: 13px; color: var(--text-muted); }

/* Export row */
.export-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }
.exp-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 7px 13px;
  font-size: 12px; font-weight: 500;
  font-family: 'Inter', sans-serif;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-md);
  background: var(--white);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all .15s;
}
.exp-btn:hover { background: var(--slate); color: var(--text-primary); }
.exp-btn i { font-size: 14px; }

/* Disclaimer */
.disclaimer {
  background: var(--warn-pale);
  border: 1px solid #FDE68A;
  border-radius: var(--radius-md);
  padding: 10px 13px;
  font-size: 12px;
  color: var(--warn);
  line-height: 1.5;
  margin-bottom: 16px;
}
.disclaimer strong { font-weight: 600; }

.disclaimer-sm {
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.5;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}

/* Emergency overlay */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.6);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999;
  padding: 20px;
}
.overlay-modal {
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: 28px;
  max-width: 380px;
  width: 100%;
  border-top: 4px solid var(--danger);
  box-shadow: var(--shadow-lg);
}
.overlay-title {
  font-size: 18px; font-weight: 600;
  color: var(--danger);
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 10px;
}
.overlay-body { font-size: 14px; line-height: 1.6; color: var(--text-primary); margin-bottom: 16px; }
.overlay-number { font-size: 32px; font-weight: 700; color: var(--danger); margin: 8px 0; line-height: 1; }
.overlay-primary { width: 100%; padding: 12px; background: var(--danger); color: var(--white); border: none; border-radius: var(--radius-md); font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer; margin-bottom: 8px; transition: opacity .15s; }
.overlay-primary:hover { opacity: .9; }
.overlay-dismiss { width: 100%; padding: 10px; background: transparent; color: var(--text-muted); border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13px; font-family: 'Inter', sans-serif; cursor: pointer; transition: all .15s; }
.overlay-dismiss:hover { background: var(--slate); }

/* Footer */
.site-footer {
  background: var(--navy);
  padding: 14px 28px;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 8px;
}
.footer-brand { font-size: 11px; color: rgba(255,255,255,.4); }
.footer-brand strong { color: rgba(255,255,255,.6); }
.footer-link { font-size: 11px; color: var(--gold); text-decoration: none; opacity: .8; transition: opacity .15s; }
.footer-link:hover { opacity: 1; }

/* Divider */
.divider { height: 1px; background: var(--border); margin: 14px 0; }

/* Responsive */
@media (max-width: 520px) {
  .site-header { padding: 14px 16px 0; }
  .main { padding: 16px; }
  .persona-grid-outer { grid-template-columns: 1fr; }
  .profile-grid { grid-template-columns: 1fr 1fr; }
  .resource-grid { grid-template-columns: 1fr; }
  .product-name { font-size: 22px; }
  .persona-tabs { overflow-x: auto; }
  .ptab { font-size: 11px; padding: 8px 12px; }
}

/* Persona cards on S1 */
.persona-grid-outer {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
  margin-bottom: 16px;
}
.persona-card-outer {
  border: 1.5px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px 14px;
  cursor: pointer;
  text-align: center;
  transition: all .15s;
  background: var(--white);
  box-shadow: var(--shadow-sm);
}
.persona-card-outer:hover { border-color: var(--teal); background: var(--teal-pale); transform: translateY(-1px); box-shadow: var(--shadow-md); }
.persona-card-outer.sel { border: 2px solid var(--teal); background: var(--teal-pale); }
.persona-card-outer i { font-size: 26px; display: block; margin-bottom: 8px; color: var(--text-muted); }
.persona-card-outer.sel i { color: var(--teal); }
.pco-title { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
.pco-desc { font-size: 11px; color: var(--text-muted); line-height: 1.4; }
.persona-card-outer.sel .pco-title { color: var(--teal); }

@media (max-width: 420px) {
  .persona-grid-outer { grid-template-columns: 1fr; }
}

/* ── ACADEMIC PANEL (in S5) ── */
.acad-entry-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 14px 0;
}
.aep-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
  background: linear-gradient(90deg, var(--navy) 0%, var(--navy-mid) 100%);
  cursor: pointer;
}
.aep-header-left { display: flex; align-items: center; gap: 9px; }
.aep-header-title { font-size: 13px; font-weight: 500; color: var(--white); }
.aep-header-sub { font-size: 11px; color: rgba(255,255,255,.45); }
.aep-badges { display: flex; gap: 5px; }
.aep-badge { font-size: 10px; font-weight: 500; padding: 2px 8px; border-radius: 20px; background: rgba(201,168,76,.15); color: var(--gold); border: 1px solid rgba(201,168,76,.25); }
.aep-body { padding: 14px 16px; background: var(--white); display: flex; gap: 10px; flex-wrap: wrap; }
.aep-mode-btn {
  flex: 1; min-width: 180px;
  display: flex; align-items: center; gap: 10px;
  padding: 11px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--off-white);
  cursor: pointer; text-align: left;
  transition: all .15s;
}
.aep-mode-btn:hover { border-color: var(--teal); background: var(--teal-pale); }
.aep-mode-icon { width: 32px; height: 32px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.aep-mode-icon.quiz { background: #EFF6FF; color: #1D4ED8; }
.aep-mode-icon.exam { background: var(--teal-pale); color: var(--teal); }
.aep-mode-title { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
.aep-mode-desc { font-size: 11px; color: var(--text-muted); line-height: 1.3; }

/* ── ACADEMIC HUB (S6) ── */
.acad-mode-card {
  border: 1.5px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px;
  cursor: pointer;
  transition: all .15s;
  background: var(--white);
}
.acad-mode-card:hover { border-color: var(--teal); box-shadow: var(--shadow-md); transform: translateY(-1px); }
.acad-mode-card.sel { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,122,107,.12); }
#track-school.sel { border-color: #7C3AED; box-shadow: 0 0 0 3px rgba(124,58,237,.12); }
#track-school.sel .amc-title { color: #7C3AED; }
.amc-icon { width: 40px; height: 40px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 20px; color: white; margin-bottom: 10px; }
.amc-title { font-size: 14px; font-weight: 600; margin-bottom: 6px; }
.amc-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 10px; }
.amc-tags { display: flex; flex-wrap: wrap; gap: 4px; }
.amc-tag { font-size: 10px; font-weight: 500; padding: 2px 8px; border-radius: 20px; background: var(--slate); color: var(--text-muted); }

.board-btn {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 12px;
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--radius-md); cursor: pointer;
  text-align: left; transition: all .15s; width: 100%;
}
.board-btn:hover { border-color: var(--teal); background: var(--teal-pale); }
.board-btn.sel { border-color: var(--teal); background: var(--teal-pale); }
.board-flag { font-size: 20px; line-height: 1; flex-shrink: 0; }
.bb-name { font-size: 13px; font-weight: 500; }
.bb-sub { font-size: 11px; color: var(--text-muted); }

.level-btn {
  padding: 7px 14px;
  background: var(--white); border: 1px solid var(--border);
  border-radius: 20px; font-size: 12px; font-weight: 500;
  font-family: 'Inter', sans-serif; cursor: pointer; transition: all .15s;
  color: var(--text-secondary);
}
.level-btn:hover { border-color: var(--teal); color: var(--teal); background: var(--teal-pale); }
.level-btn.sel { border-color: var(--teal); background: var(--teal-pale); color: var(--teal); }

/* ── QUIZ (S7) ── */
.score-badge {
  display: flex; align-items: center; gap: 4px;
  background: var(--slate); border-radius: 20px;
  padding: 4px 10px; font-size: 12px; font-weight: 600;
}
.quiz-q-card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 18px 20px;
  box-shadow: var(--shadow-sm); margin-bottom: 12px;
}
.quiz-q-text { font-size: 15px; font-weight: 500; margin-bottom: 14px; line-height: 1.45; }
.quiz-opts { display: flex; flex-direction: column; gap: 7px; }
.quiz-opt {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px;
  background: var(--off-white); border: 1px solid var(--border);
  border-radius: var(--radius-md); cursor: pointer;
  font-size: 13px; font-family: 'Inter', sans-serif;
  text-align: left; transition: all .15s; color: var(--text-primary);
}
.quiz-opt:hover:not([disabled]) { border-color: var(--teal); background: var(--teal-pale); }
.quiz-opt.correct { border-color: #16A34A; background: #F0FDF4; color: #166534; font-weight: 500; }
.quiz-opt.wrong { border-color: #DC2626; background: #FEF2F2; color: #991B1B; }
.quiz-opt.reveal { border-color: #16A34A; background: #F0FDF4; color: #166534; }
.quiz-opt-letter {
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--slate); color: var(--text-secondary);
  font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: all .15s;
}
.quiz-opt.correct .quiz-opt-letter { background: #16A34A; color: white; }
.quiz-opt.wrong .quiz-opt-letter { background: #DC2626; color: white; }
.quiz-feedback-box {
  border-radius: var(--radius-md); padding: 13px 16px;
  font-size: 13px; line-height: 1.6; margin-bottom: 12px;
}
.quiz-feedback-box.correct { background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; }
.quiz-feedback-box.wrong { background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; }
.quiz-results-card {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
  border-radius: var(--radius-lg); padding: 24px;
  text-align: center; color: white; margin-bottom: 14px;
}
.qrc-score { font-size: 52px; font-weight: 700; color: var(--gold); line-height: 1; }
.qrc-label { font-size: 13px; color: rgba(255,255,255,.6); margin-top: 4px; }
.qrc-grade { font-size: 20px; font-weight: 600; margin-top: 10px; }
.qrc-breakdown { display: flex; justify-content: center; gap: 20px; margin-top: 14px; }
.qrc-stat { text-align: center; }
.qrc-stat-num { font-size: 20px; font-weight: 600; }
.qrc-stat-lbl { font-size: 11px; color: rgba(255,255,255,.5); }

/* ── EXAM (S8) ── */
.exam-q-block {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 18px 20px;
  margin-bottom: 14px; box-shadow: var(--shadow-sm);
}
.eq-num { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
.eq-stem { font-size: 14px; font-weight: 500; line-height: 1.5; margin-bottom: 6px; }
.eq-marks { font-size: 11px; color: var(--teal); font-weight: 600; margin-bottom: 10px; }
.eq-input {
  width: 100%; padding: 10px 12px;
  border: 1px solid var(--border); border-radius: var(--radius-md);
  font-size: 13px; font-family: 'Inter', sans-serif;
  color: var(--text-primary); background: var(--off-white);
  resize: vertical; line-height: 1.5;
}
.eq-input:focus { outline: none; border-color: var(--teal); background: var(--white); }
.eq-guidance { font-size: 11px; color: var(--text-muted); margin-top: 5px; font-style: italic; }

/* ── MARKING (S9) ── */
.mark-summary {
  display: flex; gap: 10px; flex-wrap: wrap;
  background: linear-gradient(135deg, var(--navy), var(--navy-light));
  border-radius: var(--radius-lg); padding: 16px 20px; margin-bottom: 16px;
  align-items: center;
}
.ms-score-block { text-align: center; }
.ms-total { font-size: 36px; font-weight: 700; color: var(--gold); line-height: 1; }
.ms-outof { font-size: 13px; color: rgba(255,255,255,.5); }
.ms-divider { width: 1px; background: rgba(255,255,255,.15); align-self: stretch; margin: 0 4px; }
.ms-stats { display: flex; flex-wrap: wrap; gap: 12px; flex: 1; }
.ms-stat { }
.ms-stat-num { font-size: 18px; font-weight: 600; color: white; }
.ms-stat-lbl { font-size: 11px; color: rgba(255,255,255,.45); }

.mark-card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 16px 18px;
  margin-bottom: 12px; box-shadow: var(--shadow-sm);
}
.mark-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
.mark-q-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; }
.mark-q-text { font-size: 13px; font-weight: 500; margin-top: 2px; line-height: 1.4; }
.mark-score-pill {
  font-size: 12px; font-weight: 700;
  padding: 3px 11px; border-radius: 20px; flex-shrink: 0;
  white-space: nowrap;
}
.mark-score-pill.full { background: #F0FDF4; color: #166534; }
.mark-score-pill.partial { background: var(--warn-pale); color: var(--warn); }
.mark-score-pill.zero { background: #FEF2F2; color: #991B1B; }

.mark-section { margin-bottom: 10px; }
.mark-section-lbl { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 4px; }
.mark-student-ans { font-size: 13px; color: var(--text-secondary); background: var(--slate); border-radius: var(--radius-sm); padding: 8px 11px; line-height: 1.5; }
.mark-scheme { font-size: 13px; color: #166534; background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: var(--radius-sm); padding: 8px 11px; line-height: 1.5; }
.mark-feedback { font-size: 13px; color: var(--text-primary); line-height: 1.6; }
.mark-feedback strong { color: var(--navy); }

.mark-overall-advice {
  background: linear-gradient(135deg, var(--navy), var(--navy-light));
  border-radius: var(--radius-lg); padding: 16px 18px; margin-top: 14px;
}
.moa-label { font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); margin-bottom: 6px; }
.moa-text { font-size: 13px; color: rgba(255,255,255,.85); line-height: 1.65; }

/* ── DRUG COMPARISON ── */
.drug-entry-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 14px 0;
}
.dep-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 16px;
  background: linear-gradient(90deg, var(--navy), var(--navy-mid));
  cursor: pointer;
}
.dep-header-left { display: flex; align-items: center; gap: 9px; }
.dep-header-title { font-size: 13px; font-weight: 500; color: var(--white); }
.dep-badges { display: flex; gap: 5px; }
.dep-badge { font-size: 10px; font-weight: 500; padding: 2px 8px; border-radius: 20px;
  background: rgba(201,168,76,.15); color: var(--gold); border: 1px solid rgba(201,168,76,.25); }
.dep-body { padding: 12px 16px; background: var(--white);
  display: flex; gap: 10px; flex-wrap: wrap; }
.dep-drug-chip { display: flex; align-items: center; gap: 7px;
  padding: 7px 12px; border: 1px solid var(--border); border-radius: var(--radius-md);
  background: var(--off-white); cursor: pointer; font-size: 12px; font-weight: 500;
  color: var(--text-secondary); transition: all .15s; }
.dep-drug-chip:hover { border-color: var(--teal); background: var(--teal-pale); color: var(--teal); }
.dep-drug-chip i { font-size: 14px; }

/* Sort / filter buttons */
.dc-sort-btn, .dc-filter-btn {
  padding: 5px 12px; font-size: 11px; font-weight: 500;
  border: 1px solid var(--border); border-radius: 20px;
  background: var(--white); color: var(--text-secondary);
  cursor: pointer; font-family: var(--font-sans); transition: all .15s;
}
.dc-sort-btn:hover, .dc-filter-btn:hover { border-color: var(--teal); color: var(--teal); }
.dc-sort-btn.active { background: var(--teal); color: var(--white); border-color: var(--teal); }
.dc-filter-btn.active { background: var(--navy); color: var(--white); border-color: var(--navy); }

/* Drug cards */
.dc-card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 0;
  margin-bottom: 12px; box-shadow: var(--shadow-sm);
  overflow: hidden; transition: box-shadow .2s;
}
.dc-card:hover { box-shadow: var(--shadow-md); }
.dc-card-header {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 14px 16px 10px; border-bottom: 1px solid var(--border);
}
.dc-drug-icon {
  width: 38px; height: 38px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0;
}
.dc-drug-icon.branded { background: #EFF6FF; color: #1D4ED8; }
.dc-drug-icon.generic  { background: var(--teal-pale); color: var(--teal); }
.dc-drug-icon.otc      { background: var(--gold-pale); color: #7A5D1A; }
.dc-drug-name { font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: 2px; }
.dc-drug-generic { font-size: 11px; color: var(--text-muted); margin-bottom: 4px; }
.dc-type-badge { display: inline-block; font-size: 10px; font-weight: 600;
  padding: 2px 8px; border-radius: 20px; text-transform: uppercase; letter-spacing: .04em; }
.dc-type-badge.branded { background: #EFF6FF; color: #1D4ED8; }
.dc-type-badge.generic  { background: var(--teal-pale); color: var(--teal); }
.dc-type-badge.otc      { background: var(--gold-pale); color: #7A5D1A; }

/* Score bar */
.dc-score-col { text-align: center; flex-shrink: 0; min-width: 58px; }
.dc-overall-score { font-size: 28px; font-weight: 700; color: var(--navy); line-height: 1; }
.dc-score-label { font-size: 10px; color: var(--text-muted); }

/* Metrics grid */
.dc-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
  border-bottom: 1px solid var(--border); }
.dc-metric { padding: 10px 14px; border-right: 1px solid var(--border); }
.dc-metric:last-child { border-right: none; }
.dc-metric-label { font-size: 10px; font-weight: 600; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
.dc-metric-value { font-size: 15px; font-weight: 600; color: var(--text-primary); }
.dc-metric-sub { font-size: 11px; color: var(--text-muted); }
.dc-bar-wrap { height: 5px; background: var(--border); border-radius: 3px; margin-top: 5px; overflow: hidden; }
.dc-bar { height: 100%; border-radius: 3px; }

/* Stars */
.dc-stars { color: var(--gold); font-size: 14px; letter-spacing: -1px; }
.dc-star-count { font-size: 11px; color: var(--text-muted); }

/* Evidence badge */
.dc-evidence { display: inline-block; font-size: 11px; font-weight: 700;
  padding: 2px 8px; border-radius: 4px; }
.dc-evidence.A { background: #F0FDF4; color: #166534; border: 1px solid #BBF7D0; }
.dc-evidence.B { background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; }
.dc-evidence.C { background: var(--warn-pale); color: var(--warn); border: 1px solid #FDE68A; }

/* Body of card */
.dc-card-body { padding: 12px 16px; }
.dc-pros-cons { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 10px; }
.dc-pro-con-col { font-size: 12px; }
.dc-pro-con-label { font-size: 10px; font-weight: 600; text-transform: uppercase;
  letter-spacing: .05em; margin-bottom: 4px; }
.dc-pro-con-label.pros { color: #166534; }
.dc-pro-con-label.cons { color: #991B1B; }
.dc-pro-item { color: var(--text-secondary); padding: 2px 0; display: flex; gap: 5px; }
.dc-pro-item::before { content: '✓'; color: #16A34A; font-weight: 700; flex-shrink: 0; }
.dc-con-item { color: var(--text-secondary); padding: 2px 0; display: flex; gap: 5px; }
.dc-con-item::before { content: '✗'; color: #DC2626; font-weight: 700; flex-shrink: 0; }

/* User reviews strip */
.dc-reviews { padding: 10px 16px; background: var(--off-white);
  border-top: 1px solid var(--border); display: flex; align-items: center;
  justify-content: space-between; flex-wrap: wrap; gap: 8px; }
.dc-review-tags { display: flex; flex-wrap: wrap; gap: 5px; }
.dc-review-tag { font-size: 11px; padding: 2px 8px; border-radius: 20px;
  background: var(--white); border: 1px solid var(--border); color: var(--text-secondary); }
.dc-rate-btn { font-size: 11px; font-weight: 500; padding: 5px 12px;
  border: 1px solid var(--teal); border-radius: 20px; color: var(--teal);
  background: transparent; cursor: pointer; transition: all .15s; font-family: var(--font-sans); }
.dc-rate-btn:hover { background: var(--teal); color: var(--white); }

/* Feedback stars */
.dc-star { font-size: 24px; color: var(--border-strong, #CBD5E0);
  background: none; border: none; cursor: pointer; padding: 0 2px; transition: color .1s; }
.dc-star.active, .dc-star:hover { color: var(--gold); }
.dc-exp-tag { font-size: 11px; padding: 4px 10px; border: 1px solid var(--border);
  border-radius: 20px; background: var(--white); color: var(--text-secondary);
  cursor: pointer; font-family: var(--font-sans); transition: all .15s; }
.dc-exp-tag.active { background: var(--teal-pale); border-color: var(--teal); color: var(--teal); font-weight: 500; }

/* Compare winner banner */
.dc-winner-banner { background: linear-gradient(90deg, var(--navy), var(--navy-mid));
  border-radius: var(--radius-md); padding: 10px 14px; margin-bottom: 12px;
  display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--white); }
.dc-winner-banner i { color: var(--gold); font-size: 18px; flex-shrink: 0; }

/* ── VOICE MODULE ── */
.voice-bar {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 14px;
  background: linear-gradient(90deg, var(--navy), var(--navy-mid));
  border-bottom: 1px solid rgba(255,255,255,.08);
  flex-wrap: wrap;
}
.voice-bar-label { font-size: 11px; color: rgba(255,255,255,.5); letter-spacing:.04em; text-transform:uppercase; font-weight:500; flex-shrink:0; }
.vb-btn {
  display: flex; align-items: center; gap: 5px;
  padding: 5px 11px; border-radius: 20px; font-size: 11px; font-weight: 500;
  font-family: var(--font-sans); cursor: pointer; transition: all .15s; border: 1px solid rgba(255,255,255,.18);
  background: rgba(255,255,255,.06); color: rgba(255,255,255,.7);
}
.vb-btn:hover { background: rgba(255,255,255,.14); color: var(--white); }
.vb-btn.active { background: var(--teal); border-color: var(--teal); color: var(--white); }
.vb-btn.recording { background: var(--danger); border-color: var(--danger); color: var(--white); animation: pulse-btn 1.2s ease-in-out infinite; }
.vb-btn i { font-size: 14px; }
@keyframes pulse-btn { 0%,100%{opacity:1} 50%{opacity:.6} }
.vb-speed { font-size: 11px; color: rgba(255,255,255,.5); margin-left: 4px; }
.vb-speed select { background: rgba(255,255,255,.08); color: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.15); border-radius: 4px; padding: 3px 5px; font-size: 11px; font-family: var(--font-sans); cursor: pointer; }
.vb-speed select option { background: var(--navy); }

/* Mic button on inputs */
.voice-input-wrap { position: relative; }
.voice-input-wrap textarea, .voice-input-wrap input { padding-right: 44px !important; }
.mic-btn {
  position: absolute; right: 8px; bottom: 8px;
  width: 28px; height: 28px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--teal); border: none; cursor: pointer;
  transition: all .15s; z-index: 2; flex-shrink: 0;
}
.mic-btn:hover { background: var(--teal-light); transform: scale(1.08); }
.mic-btn.recording { background: var(--danger); animation: pulse-btn 1s ease-in-out infinite; }
.mic-btn i { font-size: 14px; color: var(--white); }
.mic-btn-inline {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 6px 13px; border-radius: 20px; font-size: 12px; font-weight: 500;
  background: var(--teal-pale); border: 1px solid rgba(13,122,107,.3);
  color: var(--teal); cursor: pointer; font-family: var(--font-sans);
  transition: all .15s; margin-left: 6px; vertical-align: middle;
}
.mic-btn-inline:hover { background: var(--teal); color: var(--white); }
.mic-btn-inline.recording { background: var(--danger); border-color: var(--danger); color: var(--white); animation: pulse-btn 1s ease-in-out infinite; }
.mic-btn-inline i { font-size: 13px; }

/* Speak button on output */
.speak-btn {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 500;
  background: transparent; border: 1px solid var(--border-strong);
  color: var(--text-muted); cursor: pointer; font-family: var(--font-sans);
  transition: all .15s; margin-top: 6px;
}
.speak-btn:hover { background: var(--teal-pale); border-color: var(--teal); color: var(--teal); }
.speak-btn.speaking { background: var(--teal-pale); border-color: var(--teal); color: var(--teal); }
.speak-btn i { font-size: 12px; }

/* Transcript strip */
.transcript-strip {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 7px 11px; margin-top: 6px;
  background: var(--teal-pale); border: 1px solid rgba(13,122,107,.25);
  border-radius: var(--radius-md); font-size: 12px; color: var(--teal);
  line-height: 1.4; animation: fadeIn .25s ease;
}
.transcript-strip i { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
@keyframes fadeIn { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:none} }

/* Voice status toast */
.voice-toast {
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  background: var(--navy); color: var(--white); padding: 9px 18px;
  border-radius: 20px; font-size: 13px; font-weight: 500; z-index: 9998;
  display: flex; align-items: center; gap: 8px; box-shadow: var(--shadow-lg);
  animation: fadeIn .2s ease; pointer-events: none;
}
.voice-toast i { font-size: 15px; color: var(--gold); }
.voice-not-supported {
  background: var(--warn-pale); border: 1px solid #FDE68A;
  border-radius: var(--radius-md); padding: 9px 13px;
  font-size: 12px; color: var(--warn); margin: 8px 0;
}
</style>
</head>
<body>

<!-- EMERGENCY OVERLAY -->
<div class="overlay" id="overlay" style="display:none">
  <div class="overlay-modal">
    <div class="overlay-title"><i class="ti ti-alert-triangle"></i>Possible emergency</div>
    <div class="overlay-body">
      Your symptoms include red flag indicators that may require <strong>immediate medical attention</strong>.<br><br>
      Emergency number for <span id="ov-geo"></span>:
      <div class="overlay-number" id="ov-num">999</div>
      Do not wait — call now if you have any doubt.
    </div>
    <button class="overlay-primary" onclick="closeOverlay(true)"><i class="ti ti-check" style="font-size:15px;vertical-align:-2px;margin-right:5px"></i>I understand — show me the analysis</button>
    <button class="overlay-dismiss" onclick="closeOverlay(false)">Dismiss</button>
  </div>
</div>

<!-- HEADER -->
<header class="site-header">
  <div class="header-top">
    <div class="brand">
      <div class="brand-mark">VKR</div>
      <div class="brand-text">
        <div class="brand-name">VKR Global</div>
        <div class="brand-sub">Advisory &amp; Technology</div>
      </div>
    </div>
    <span class="header-badge">Demo</span>
  </div>
  <div class="product-hero">
    <div class="product-eyebrow">VKRMed Health Intelligence</div>
    <div class="product-name">VKR<span>Med</span></div>
    <div class="gold-rule"></div>
    <div class="product-desc">AI-powered symptom analysis. Personalised by role, geography, and profile. For patients, clinicians, and researchers — each gets the depth they need.</div>
  </div>
  <nav class="persona-tabs" aria-label="Active persona">
    <button class="ptab active" id="ptab-patient" onclick="switchTab('patient')">Patient / Carer</button>
    <button class="ptab" id="ptab-professional" onclick="switchTab('professional')">Medical Professional</button>
    <button class="ptab" id="ptab-student" onclick="switchTab('student')">Student / Researcher</button>
  </nav>
</header>

<!-- VOICE CONTROL BAR -->
<div class="voice-bar" id="voice-bar">
  <span class="voice-bar-label"><i class="ti ti-microphone" style="font-size:12px;vertical-align:-1px;margin-right:4px;"></i>Voice</span>
  <button class="vb-btn" id="vb-input-toggle" onclick="vbToggleInput()" title="Toggle voice input">
    <i class="ti ti-microphone" id="vb-input-icon"></i>
    <span id="vb-input-label">Voice input: Off</span>
  </button>
  <button class="vb-btn" id="vb-tts-toggle" onclick="vbToggleTTS()" title="Toggle spoken responses">
    <i class="ti ti-volume" id="vb-tts-icon"></i>
    <span id="vb-tts-label">Read aloud: Off</span>
  </button>
  <button class="vb-btn" id="vb-stop-btn" onclick="vbStopSpeaking()" style="display:none;" title="Stop speaking">
    <i class="ti ti-player-stop"></i> Stop
  </button>
  <span class="vb-speed" id="vb-speed-wrap" style="display:none;">
    Speed:
    <select id="vb-speed" onchange="vbSetSpeed(this.value)">
      <option value="0.8">Slow</option>
      <option value="1.0" selected>Normal</option>
      <option value="1.25">Fast</option>
      <option value="1.5">Faster</option>
    </select>
    Voice:
    <select id="vb-voice" onchange="vbSetVoice(this.value)">
      <option value="">Default</option>
    </select>
  </span>
  <span id="vb-status" style="font-size:11px;color:rgba(255,255,255,.4);margin-left:auto;"></span>
</div>

<!-- MAIN -->
<main class="main">

  <!-- S1: SETUP -->
  <div id="s1" class="screen active">
    <div class="step-row">
      <div class="step-node active" id="sn1">1</div>
      <div class="step-connector" id="sc1"></div>
      <div class="step-node idle" id="sn2">2</div>
      <div class="step-connector" id="sc2"></div>
      <div class="step-node idle" id="sn3">3</div>
      <div class="step-connector" id="sc3"></div>
      <div class="step-node idle" id="sn4">4</div>
      <span class="step-label">Your profile</span>
    </div>
    <div class="disclaimer"><strong>Educational use only.</strong> VKRMed does not diagnose or treat. Always consult a qualified healthcare professional. In an emergency call your local emergency services immediately.</div>

    <h3 class="screen-title">Who is using VKRMed?</h3>
    <p class="screen-sub">Your role, location, and profile shape the terminology, depth, and resources we surface.</p>

    <div class="sec-lbl">Role</div>
    <div class="persona-grid-outer">
      <div class="persona-card-outer" data-p="patient" onclick="selPersona(this)">
        <i class="ti ti-user-heart"></i>
        <div class="pco-title">Patient / Carer</div>
        <div class="pco-desc">Plain English, practical guidance, when to seek help</div>
      </div>
      <div class="persona-card-outer" data-p="professional" onclick="selPersona(this)">
        <i class="ti ti-stethoscope"></i>
        <div class="pco-title">Medical Professional</div>
        <div class="pco-desc">ICD-10 codes, differentials, red flags, clinical guidelines</div>
      </div>
      <div class="persona-card-outer" data-p="student" onclick="selPersona(this)">
        <i class="ti ti-school"></i>
        <div class="pco-title">Student / Researcher</div>
        <div class="pco-desc">Pathophysiology, live research, contribute &amp; comment</div>
      </div>
    </div>

    <div class="sec-lbl" style="margin-top:14px">Region</div>
    <div class="geo-grid">
      <button class="g-btn" data-g="uk" onclick="selGeo(this)"><span class="g-flag">🇬🇧</span> United Kingdom</button>
      <button class="g-btn" data-g="us" onclick="selGeo(this)"><span class="g-flag">🇺🇸</span> United States</button>
      <button class="g-btn" data-g="aus" onclick="selGeo(this)"><span class="g-flag">🇦🇺</span> Australia / NZ</button>
      <button class="g-btn" data-g="sg" onclick="selGeo(this)"><span class="g-flag">🇸🇬</span> Singapore</button>
      <button class="g-btn" data-g="eu" onclick="selGeo(this)"><span class="g-flag">🇪🇺</span> Europe</button>
      <button class="g-btn" data-g="canada" onclick="selGeo(this)"><span class="g-flag">🇨🇦</span> Canada</button>
      <button class="g-btn" data-g="other" onclick="selGeo(this)"><i class="ti ti-world" style="font-size:17px"></i> Other / Global</button>
    </div>

    <div class="sec-lbl" style="margin-top:14px">Profile <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:12px;color:var(--text-muted)">(optional — improves analysis)</span></div>
    <div class="profile-grid">
      <div class="field-group"><label>Age</label><input type="number" id="prof-age" min="0" max="120" placeholder="e.g. 42"></div>
      <div class="field-group"><label>Sex</label>
        <select id="prof-sex">
          <option value="">Prefer not to say</option>
          <option value="male">Male</option>
          <option value="female">Female</option>
          <option value="other">Other / non-binary</option>
        </select>
      </div>
      <div class="field-group"><label>Existing conditions</label><input type="text" id="prof-cond" placeholder="e.g. asthma, diabetes"></div>
    </div>

    <div class="btn-row">
      <button class="btn-primary" id="btn-s1" disabled onclick="goS2()">Continue →</button>
    </div>
    <!-- Early academic access for students -->
    <div id="early-acad-hint" style="display:none;margin-top:16px;padding:12px 14px;background:linear-gradient(90deg,rgba(13,122,107,.07),rgba(11,31,58,.04));border:1px solid rgba(13,122,107,.2);border-radius:var(--radius-md);">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
        <div>
          <div style="font-size:13px;font-weight:500;color:var(--teal);margin-bottom:2px;"><i class="ti ti-bolt" style="font-size:14px;vertical-align:-2px;margin-right:4px;"></i>Student shortcut</div>
          <div style="font-size:12px;color:var(--text-muted);">Skip the symptom analysis — go straight to Quiz or Exam practice on any medical topic.</div>
        </div>
        <button class="btn-primary" onclick="earlyAcadAccess()" style="background:var(--teal);white-space:nowrap;">Jump to learning →</button>
      </div>
    </div>
  </div>

  <!-- S2: SYMPTOMS -->
  <div id="s2" class="screen">
    <div class="step-row">
      <div class="step-node done">✓</div>
      <div class="step-connector done"></div>
      <div class="step-node active">2</div>
      <div class="step-connector"></div>
      <div class="step-node idle">3</div>
      <div class="step-connector"></div>
      <div class="step-node idle">4</div>
      <span class="step-label">Symptoms</span>
    </div>
    <div class="chips" id="chips-s2"></div>
    <h3 class="screen-title">What are you experiencing?</h3>
    <p class="screen-sub">Select symptoms below and / or describe in your own words.</p>
    <div class="sec-lbl">Common symptoms</div>
    <div class="sym-grid">
      <button class="sym-btn" data-s="Headache" onclick="togSym(this)"><i class="ti ti-brain"></i>Headache</button>
      <button class="sym-btn" data-s="Fever" onclick="togSym(this)"><i class="ti ti-thermometer"></i>Fever</button>
      <button class="sym-btn" data-s="Cough" onclick="togSym(this)"><i class="ti ti-lungs"></i>Cough</button>
      <button class="sym-btn" data-s="Fatigue" onclick="togSym(this)"><i class="ti ti-zzz"></i>Fatigue</button>
      <button class="sym-btn" data-s="Nausea" onclick="togSym(this)"><i class="ti ti-mood-sick"></i>Nausea</button>
      <button class="sym-btn" data-s="Sore throat" onclick="togSym(this)"><i class="ti ti-virus"></i>Sore throat</button>
      <button class="sym-btn" data-s="Chest pain" onclick="togSym(this)"><i class="ti ti-heart"></i>Chest pain</button>
      <button class="sym-btn" data-s="Shortness of breath" onclick="togSym(this)"><i class="ti ti-wind"></i>Shortness of breath</button>
      <button class="sym-btn" data-s="Abdominal pain" onclick="togSym(this)"><i class="ti ti-droplet"></i>Abdominal pain</button>
      <button class="sym-btn" data-s="Rash" onclick="togSym(this)"><i class="ti ti-sun"></i>Rash</button>
      <button class="sym-btn" data-s="Joint pain" onclick="togSym(this)"><i class="ti ti-bone"></i>Joint pain</button>
      <button class="sym-btn" data-s="Dizziness" onclick="togSym(this)"><i class="ti ti-rotate"></i>Dizziness</button>
      <button class="sym-btn" data-s="Back pain" onclick="togSym(this)"><i class="ti ti-spine"></i>Back pain</button>
      <button class="sym-btn" data-s="Anxiety / stress" onclick="togSym(this)"><i class="ti ti-brain"></i>Anxiety / stress</button>
      <button class="sym-btn" data-s="Sleep issues" onclick="togSym(this)"><i class="ti ti-moon"></i>Sleep issues</button>
      <button class="sym-btn" data-s="Vision changes" onclick="togSym(this)"><i class="ti ti-eye"></i>Vision changes</button>
      <button class="sym-btn" data-s="Palpitations" onclick="togSym(this)"><i class="ti ti-heartbeat"></i>Palpitations</button>
      <button class="sym-btn" data-s="Swelling" onclick="togSym(this)"><i class="ti ti-arrows-maximize"></i>Swelling</button>
    </div>
    <div class="sec-lbl" style="margin-top:10px">Or describe in your own words
      <button class="mic-btn-inline" id="mic-freetext" onclick="vbStartRecording('free-text',this)" title="Speak your symptoms">
        <i class="ti ti-microphone"></i> Speak
      </button>
    </div>
    <div class="voice-input-wrap" style="position:relative;">
      <textarea class="desc-input" id="free-text" rows="3" placeholder="e.g. throbbing pain behind both eyes for 3 days, worse in the morning, with mild nausea…"></textarea>
    </div>
    <div id="transcript-freetext" style="display:none;" class="transcript-strip">
      <i class="ti ti-microphone"></i><span id="transcript-freetext-text">Listening…</span>
    </div>
    <div class="btn-row">
      <button class="btn-primary" onclick="goS3()">Continue →</button>
      <button class="btn-secondary" onclick="goScreen('s1')">← Back</button>
    </div>
  </div>

  <!-- S3: AI Q&A -->
  <div id="s3" class="screen">
    <div class="step-row">
      <div class="step-node done">✓</div>
      <div class="step-connector done"></div>
      <div class="step-node done">✓</div>
      <div class="step-connector done"></div>
      <div class="step-node active">3</div>
      <div class="step-connector"></div>
      <div class="step-node idle">4</div>
      <span class="step-label">Follow-up</span>
    </div>
    <div class="prog-wrap"><div class="prog-fill" id="prog" style="width:0%"></div></div>
    <div class="chips" id="chips-s3"></div>
    <div id="qa-area"></div>
    <div id="qa-loading" style="display:none" class="loading-wrap">
      <div class="loading-label">Generating next question…</div>
      <div class="progress-anim"><div class="progress-anim-fill"></div></div>
    </div>
    <div class="btn-row"><button class="btn-secondary" onclick="skipToAnalysis()">Skip to analysis →</button></div>
  </div>

  <!-- S4: LOADING -->
  <div id="s4" class="screen">
    <div class="step-row">
      <div class="step-node done">✓</div>
      <div class="step-connector done"></div>
      <div class="step-node done">✓</div>
      <div class="step-connector done"></div>
      <div class="step-node done">✓</div>
      <div class="step-connector done"></div>
      <div class="step-node active">4</div>
      <span class="step-label">Analysis</span>
    </div>
    <div class="chips" id="chips-s4"></div>
    <div style="padding: 32px 0 20px;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--navy));display:flex;align-items:center;justify-content:center;animation:spin 2s linear infinite;">
          <i class="ti ti-brain" style="font-size:20px;color:white;"></i>
        </div>
        <div>
          <div style="font-size:15px;font-weight:500;color:var(--text-primary);margin-bottom:3px;">VKRMed AI</div>
          <div class="loading-label" id="load-msg" style="margin:0">Analysing your symptoms…</div>
        </div>
      </div>
      <div class="progress-anim" style="width:100%;max-width:320px"><div class="progress-anim-fill"></div></div>
      <div id="load-steps" style="margin-top:20px;display:flex;flex-direction:column;gap:8px;"></div>
    </div>
  </div>

  <!-- S5: RESULTS -->
  <div id="s5" class="screen">
    <div class="chips" id="chips-s5"></div>
    <div id="urgency-area"></div>
    <h3 class="screen-title">Analysis</h3>
    <p class="screen-sub" id="r-sub"></p>
    <div id="results-area"></div>
    <div id="advice-area"></div>
    <div id="research-area"></div>
    <div id="drug-compare-area"></div>
    <div id="academic-panel"></div>
    <div class="divider"></div>
    <div class="sec-lbl">Resources — <span id="res-geo-lbl"></span></div>
    <div class="resource-grid" id="resource-area"></div>
    <div class="export-row" id="export-row"></div>
    <div style="background:linear-gradient(135deg,var(--navy) 0%,var(--navy-light) 100%);border-radius:var(--radius-lg);padding:18px 20px;margin-top:16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-bottom:4px;">VKR Global Advisory</div>
        <div style="font-size:14px;font-weight:500;color:white;margin-bottom:3px;">Need expert financial or clinical advisory?</div>
        <div style="font-size:12px;color:rgba(255,255,255,.55);line-height:1.4;">VKRMed is one of several intelligent tools built by VKR Global. Speak to our team.</div>
      </div>
      <a href="https://vkrglobal.net" target="_blank" rel="noopener" style="background:var(--gold);color:var(--navy);border:none;border-radius:var(--radius-md);padding:10px 20px;font-size:13px;font-weight:600;font-family:'Inter',sans-serif;cursor:pointer;text-decoration:none;white-space:nowrap;transition:background .15s;display:inline-block;" onmouseover="this.style.background='#E8C96A'" onmouseout="this.style.background='var(--gold)'">Visit VKR Global ↗</a>
    </div>
    <div class="btn-row" style="margin-top:14px">
      <button class="btn-primary" onclick="resetAll()">← Start over</button>
    </div>
