// ── ROBUST JSON PARSER ──
// Handles: backtick fences, truncated arrays, trailing commas, partial JSON
function robustParse(raw) {
  if (!raw) return null;
  // Strip markdown fences
  let s = raw.replace(/```json\s*/gi, '').replace(/```\s*/g, '').trim();
  // Try direct parse first
  try { return JSON.parse(s); } catch {}
  // Extract first JSON object
  const objMatch = s.match(/\{[\s\S]*\}/);
  if (objMatch) {
    try { return JSON.parse(objMatch[0]); } catch {}
    // Try fixing truncated JSON by closing open structures
    let fixed = objMatch[0];
    // Count unclosed brackets/braces
    let braces = 0, brackets = 0, inStr = false, escaped = false;
    for (let i = 0; i < fixed.length; i++) {
      const c = fixed[i];
      if (escaped) { escaped = false; continue; }
      if (c === '\\' && inStr) { escaped = true; continue; }
      if (c === '"') { inStr = !inStr; continue; }
      if (!inStr) {
        if (c === '{') braces++;
        else if (c === '}') braces--;
        else if (c === '[') brackets++;
        else if (c === ']') brackets--;
      }
    }
    // Remove trailing comma before closing
    fixed = fixed.replace(/,\s*([}\]])/g, '$1');
    // Close any open strings, arrays, objects
    if (inStr) fixed += '"';
    while (brackets > 0) { fixed += ']'; brackets--; }
    while (braces > 0) { fixed += '}'; braces--; }
    try { return JSON.parse(fixed); } catch {}
  }
  return null;
}

