// ── EARLY ACADEMIC ACCESS ──
let learnerTrack = null;  // 'school' | 'uni'
let schoolCountry = null;
let schoolBoard = null;   // board object
let schoolYear = null;
let schoolSubject = null;
let eaMode = null;

function earlyAcadAccess() {
  if (!geo) geo = 'uk';
  learnerTrack = null; schoolCountry = null; schoolBoard = null;
  schoolYear = null; schoolSubject = null; eaMode = null; acadTopic = '';
  // Reset UI
  ['school-config','uni-config','topic-config'].forEach(id => {
    const el = document.getElementById(id); if (el) el.style.display = 'none';
  });
  ['track-school','track-uni'].forEach(id => {
    const el = document.getElementById(id); if (el) el.classList.remove('sel');
  });
  document.querySelectorAll('#school-country-btns .level-btn').forEach(b => b.classList.remove('sel'));
  const btn = document.getElementById('btn-ea-go'); if (btn) btn.disabled = true;
  goScreen('s10');
}

function selectTrack(track) {
  learnerTrack = track;
  ['track-school','track-uni'].forEach(id => document.getElementById(id).classList.toggle('sel', id === 'track-'+track));
  document.getElementById('school-config').style.display = track === 'school' ? 'block' : 'none';
  document.getElementById('uni-config').style.display = track === 'uni' ? 'block' : 'none';
  document.getElementById('topic-config').style.display = 'none';
  if (track === 'uni') {
    // For uni, pre-set defaults and show topic immediately after board selection
    acadLevel = acadLevel || 'Clinical / Year 3–4';
  }
  checkTopicReady();
}

function selectSchoolCountry(btn) {
  document.querySelectorAll('#school-country-btns .level-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  schoolCountry = btn.dataset.c;
  const data = SCHOOL_BOARDS[schoolCountry] || SCHOOL_BOARDS.other;
  // Render boards
  document.getElementById('school-board-grid').innerHTML = data.boards.map(b =>
    `<button class="board-btn" data-board="${b.name}" data-style="${b.name} ${b.sub}" onclick="selSchoolBoard(this,'${b.id}')">
      <span class="board-flag">${b.flag}</span>
      <div><div class="bb-name">${b.name}</div><div class="bb-sub">${b.sub}</div></div>
    </button>`).join('');
  // Render year groups
  document.getElementById('school-year-grid').innerHTML = data.years.map(y =>
    `<button class="level-btn" data-level="${y}" onclick="selSchoolYear(this)">${y}</button>`).join('');
  // Render subjects
  document.getElementById('school-subject-grid').innerHTML = data.subjects.map(s =>
    `<button class="level-btn" data-subject="${s}" onclick="selSchoolSubject(this)">${s}</button>`).join('');
  document.getElementById('school-boards-area').style.display = 'block';
  // Reset downstream
  schoolBoard = null; schoolYear = null; schoolSubject = null;
  document.getElementById('topic-config').style.display = 'none';
  checkTopicReady();
}

function selSchoolBoard(btn, id) {
  document.querySelectorAll('#school-board-grid .board-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  schoolBoard = { id, name: btn.dataset.board, style: btn.dataset.style };
  acadBoard = btn.dataset.board;
  checkTopicReady();
}

function selSchoolYear(btn) {
  document.querySelectorAll('#school-year-grid .level-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  schoolYear = btn.dataset.level;
  acadLevel = schoolYear;
  checkTopicReady();
}

function selSchoolSubject(btn) {
  document.querySelectorAll('#school-subject-grid .level-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  schoolSubject = btn.dataset.subject;
  acadTopic = '';
  // Show topic config with subject-specific chips
  const topics = SCHOOL_TOPICS[schoolSubject] || SCHOOL_TOPICS['Biology'];
  document.getElementById('topic-quick-btns').innerHTML = topics.map(t =>
    `<button class="level-btn" onclick="setQuickTopic(this,'${t}')">${t}</button>`).join('');
  document.getElementById('custom-topic-input').value = '';
  document.getElementById('custom-topic-input').placeholder = `e.g. ${topics[0]}, ${topics[1]}, ${topics[2]}…`;
  document.getElementById('topic-config').style.display = 'block';
  // Reset mode
  ['ea-card-quiz','ea-card-exam'].forEach(id => { const el=document.getElementById(id); if(el) el.classList.remove('sel'); });
  eaMode = null;
  checkTopicReady();
}

function setQuickTopic(btn, topic) {
  document.querySelectorAll('#topic-quick-btns .level-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  document.getElementById('custom-topic-input').value = '';
  acadTopic = topic;
  checkTopicReady();
}

function checkTopicReady() {
  const custom = document.getElementById('custom-topic-input');
  if (custom && custom.value.trim()) {
    acadTopic = custom.value.trim();
    document.querySelectorAll('#topic-quick-btns .level-btn').forEach(b => b.classList.remove('sel'));
  }
  let ready = false;
  if (learnerTrack === 'school') {
    ready = !!(schoolBoard && schoolYear && schoolSubject && acadTopic && eaMode);
  } else if (learnerTrack === 'uni') {
    ready = !!(acadBoard && acadLevel && acadTopic && eaMode);
  }
  const btn = document.getElementById('btn-ea-go');
  if (btn) btn.disabled = !ready;
}

// Show topic chips for uni track after board/level selected
function selBoard(el) {
  document.querySelectorAll('.board-btn').forEach(b => b.classList.remove('sel'));
  el.classList.add('sel');
  acadBoard = el.dataset.board;
  // If we're in uni track on S10, show topic config with medical topics
  if (learnerTrack === 'uni' && document.getElementById('s10').classList.contains('active')) {
    document.getElementById('topic-quick-btns').innerHTML = MEDICAL_TOPICS.map(t =>
      `<button class="level-btn" onclick="setQuickTopic(this,'${t}')">${t}</button>`).join('');
    document.getElementById('custom-topic-input').placeholder = 'e.g. Rheumatoid Arthritis, Pulmonary Embolism, Cushing\'s Syndrome…';
    document.getElementById('topic-config').style.display = 'block';
    ['ea-card-quiz','ea-card-exam'].forEach(id => { const el2=document.getElementById(id); if(el2) el2.classList.remove('sel'); });
    eaMode = null;
  }
  checkTopicReady();
}

function selLevel(el) {
  document.querySelectorAll('.level-btn').forEach(b => {
    // Only deselect level-btns that are actual level selectors (not subject/country/topic chips)
    if (b.dataset.level) b.classList.remove('sel');
  });
  el.classList.add('sel');
  acadLevel = el.dataset.level;
  if (learnerTrack === 'uni' && acadBoard) {
    document.getElementById('topic-quick-btns').innerHTML = MEDICAL_TOPICS.map(t =>
      `<button class="level-btn" onclick="setQuickTopic(this,'${t}')">${t}</button>`).join('');
    document.getElementById('topic-config').style.display = 'block';
  }
  checkTopicReady();
}

function selectEaMode(mode) {
  eaMode = mode; acadMode = mode;
  ['ea-card-quiz','ea-card-exam'].forEach(id => {
    const el = document.getElementById(id); if (el) el.classList.toggle('sel', id === 'ea-card-'+mode);
  });
  checkTopicReady();
}

function launchEarlyAcad() {
  if (!geo) geo = 'uk';
  if (!persona) persona = 'student';
  acadMode = eaMode;
  // Build a descriptive board string for the AI prompt
  if (learnerTrack === 'school') {
    acadBoard = `${schoolBoard.name} (${schoolSubject} — ${schoolYear})`;
    acadLevel = schoolYear;
  }
  if (acadMode === 'quiz') startQuiz();
  else startExam();
}

