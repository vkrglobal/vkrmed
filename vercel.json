async function startExam() {
  examQs = []; examAnswers = {};
  goScreen('s8');
  document.getElementById('exam-board-lbl').textContent = acadBoard;
  document.getElementById('exam-board-lbl2').textContent = acadBoard;
  document.getElementById('exam-level-lbl').textContent = acadLevel;
  document.getElementById('exam-topic-lbl').textContent = acadTopic;
  document.getElementById('exam-area').innerHTML = '';
  document.getElementById('exam-submit-row').style.display = 'none';
  document.getElementById('exam-loading').style.display = 'block';

  const msgs = ['Generating exam questions…','Applying marking scheme style…','Setting paper difficulty…'];
  let mi = 0;
  const iv = setInterval(() => { const el = document.getElementById('exam-load-msg'); if(el) el.textContent = msgs[mi++ % msgs.length]; }, 1400);

  const isSchool = learnerTrack === 'school';
  const boardDesc = isSchool ? `${acadBoard}` : acadBoard;
  const levelDesc = isSchool ? (schoolYear || acadLevel) : acadLevel;
  const subjectCtx = isSchool ? `Subject: ${schoolSubject}. ` : '';

  const sys = `You are a past-paper exam question generator for VKRMed by VKR Global. ${subjectCtx}Exam board: ${boardDesc}. Level: ${levelDesc}. Topic: ${acadTopic}.
Generate exactly 5 structured exam questions styled authentically to ${boardDesc}.
${isSchool
  ? `SCHOOL EXAM STYLE: Use the exact question types, command words (describe, explain, evaluate, calculate, compare), and mark allocations typical of ${acadBoard} ${schoolSubject}. Include structured questions with part (a), (b), (c) where appropriate. Marking scheme must reflect how the actual board awards marks — specific creditworthy points, max marks per sub-part.`
  : `MEDICAL BOARD STYLE: Mix question types: short answer (2–4 marks), extended matching (4–6 marks), one essay/SAQ (8–10 marks). Include clinical vignettes. Marking scheme must be specific and clinically accurate.`}
Each question must have a detailed marking scheme listing every mark-earning point.
Return ONLY valid JSON, no markdown:
{"questions":[{"num":1,"type":"Structured|Short Answer|Essay|Extended Matching","stem":"full question text","marks":4,"guidance":"what a good answer covers","marking_scheme":["creditworthy point 1 (1 mark)","creditworthy point 2 (1 mark)","creditworthy point 3 (1 mark)","creditworthy point 4 (1 mark)"]}]}`;

  try {
    const res = await fetch('/api/anthropic', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 4000, system: sys,
        messages: [{ role: 'user', content: `Generate ${boardDesc} exam questions on: ${acadTopic}. Level: ${levelDesc}. ${subjectCtx}` }] })
    });
    clearInterval(iv);
    const d = await res.json();
    const raw = d.content.map(b => b.text || '').join('');
    let p = robustParse(raw);
    document.getElementById('exam-loading').style.display = 'none';
    if (!p || !p.questions || !p.questions.length) {
      document.getElementById('exam-area').innerHTML = '<div class="error-msg">Could not generate questions. Please try again.</div>';
      return;
    }
    examQs = p.questions;
    renderExamPaper();
  } catch {
    clearInterval(iv);
    document.getElementById('exam-loading').style.display = 'none';
    document.getElementById('exam-area').innerHTML = '<div class="error-msg">Connection error. Please try again.</div>';
  }
}

function renderExamPaper() {
  const totalMarks = examQs.reduce((s, q) => s + (q.marks || 0), 0);
  document.getElementById('exam-area').innerHTML = `
    <div style="background:var(--slate);border-radius:var(--radius-md);padding:10px 14px;margin-bottom:16px;font-size:12px;color:var(--text-secondary);">
      <strong style="color:var(--text-primary)">${acadBoard} — ${acadLevel} Examination Paper</strong><br>
      Topic: ${acadTopic} · Total marks: ${totalMarks} · Questions: ${examQs.length}<br>
      <span style="color:var(--text-muted)">Write your answers in full. The AI will mark each answer against the marking scheme.</span>
    </div>
    ${examQs.map((q, i) => `
      <div class="exam-q-block">
        <div class="eq-num" style="display:flex;align-items:center;justify-content:space-between;">
          <span>Question ${q.num || i+1} — ${q.type || 'Short Answer'}</span>
          <button class="speak-btn" onclick="vbSpeak(${JSON.stringify((q.stem||'') + (q.guidance ? '. Guidance: '+q.guidance : ''))})" aria-label="Read question aloud"><i class="ti ti-volume"></i> Hear</button>
        </div>
        <div class="eq-stem">${q.stem}</div>
        <div class="eq-marks">[${q.marks} mark${q.marks !== 1 ? 's' : ''}]</div>
        ${q.guidance ? `<div class="eq-guidance">Guidance: ${q.guidance}</div>` : ''}
        <div class="voice-input-wrap" style="position:relative;">
          <textarea class="eq-input" id="exam-ans-${i}" rows="${q.type === 'Essay' ? 8 : 4}" placeholder="Write or speak your answer…" oninput="checkExamReady()" style="padding-right:44px;"></textarea>
          <button class="mic-btn" id="mic-exam-${i}" onclick="vbStartRecording('exam-ans-${i}',this)" title="Speak your answer" aria-label="Voice input for answer ${i+1}"><i class="ti ti-microphone"></i></button>
        </div>
        <div id="transcript-exam-ans-${i}" style="display:none;" class="transcript-strip">
          <i class="ti ti-microphone"></i><span id="transcript-exam-ans-${i}-text">Listening…</span>
        </div>
      </div>`).join('')}`;

  document.getElementById('exam-submit-row').style.display = 'flex';
}

function checkExamReady() {
  // enable submit once at least one answer is non-empty
  const hasAny = examQs.some((_, i) => {
    const el = document.getElementById('exam-ans-' + i);
    return el && el.value.trim().length > 0;
  });
  const btn = document.querySelector('#exam-submit-row .btn-gold');
  if (btn) btn.disabled = !hasAny;
}

async function submitExam() {
  // collect answers
  examAnswers = {};
  examQs.forEach((q, i) => {
    const el = document.getElementById('exam-ans-' + i);
    examAnswers[i] = el ? el.value.trim() : '';
  });

  goScreen('s8');
  document.getElementById('exam-area').innerHTML = '';
  document.getElementById('exam-submit-row').style.display = 'none';
  document.getElementById('exam-loading').style.display = 'block';
  document.getElementById('exam-load-msg').textContent = 'Marking your answers…';

  const isSchoolMark = learnerTrack === 'school';
  const sys = `You are an expert examiner for ${acadBoard} at ${acadLevel} level, marking student answers on the topic of ${acadTopic}${isSchoolMark ? ` (subject: ${schoolSubject})` : ''}.
Mark each answer strictly against the provided marking scheme. Award marks for each creditworthy point the student demonstrates. ${isSchoolMark ? `Apply ${acadBoard} marking conventions — accept alternative correct answers, apply error carried forward where appropriate, reward the relevant command word (describe/explain/evaluate/calculate).` : `Be clinically rigorous. Partial credit where understanding is demonstrated.`}
Return ONLY valid JSON, no markdown:
{"results":[{"q_num":1,"marks_awarded":2,"marks_available":4,"points_awarded":["point text ✓"],"points_missed":["missed point — student did not mention X"],"feedback":"detailed examiner feedback — what was good, what was missed, how to improve","grade":"Excellent|Good|Satisfactory|Needs improvement"}],"total_awarded":6,"total_available":20,"overall_grade":"Distinction|Merit|Pass|Fail","examiner_comments":"overall feedback on the script with specific revision recommendations"}`;

  const userMsg = examQs.map((q, i) => `Q${q.num||i+1} [${q.marks}m] — ${q.stem}\nMarking scheme: ${(q.marking_scheme||[]).join(' | ')}\nStudent answer: ${examAnswers[i] || '(no answer provided)'}`).join('\n\n');

  try {
    const res = await fetch('/api/anthropic', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 4000, system: sys,
        messages: [{ role: 'user', content: userMsg }] })
    });
    const d = await res.json();
    const raw = d.content.map(b => b.text || '').join('');
    let p = robustParse(raw);
    document.getElementById('exam-loading').style.display = 'none';
    if (!p || !p.results) {
      document.getElementById('exam-area').innerHTML = '<div class="error-msg">Marking failed. Please try again.</div>';
      document.getElementById('exam-submit-row').style.display = 'flex';
      return;
    }
    renderMarkingResults(p);
    goScreen('s9');
  } catch {
    document.getElementById('exam-loading').style.display = 'none';
    document.getElementById('exam-area').innerHTML = '<div class="error-msg">Connection error. Please try again.</div>';
    document.getElementById('exam-submit-row').style.display = 'flex';
  }
}

function renderMarkingResults(data) {
  document.getElementById('mark-board-lbl').textContent = acadBoard + ' ' + acadLevel;

  const pct = data.total_available ? Math.round((data.total_awarded / data.total_available) * 100) : 0;
  const gradeColor = pct >= 80 ? '#16A34A' : pct >= 65 ? '#0D7A6B' : pct >= 50 ? '#D97706' : '#DC2626';

  document.getElementById('mark-summary-bar').innerHTML = `
    <div class="mark-summary">
      <div class="ms-score-block">
        <div class="ms-total">${data.total_awarded}</div>
        <div class="ms-outof">/ ${data.total_available} marks</div>
      </div>
      <div class="ms-divider"></div>
      <div class="ms-stats">
        <div class="ms-stat"><div class="ms-stat-num" style="color:${gradeColor}">${pct}%</div><div class="ms-stat-lbl">Score</div></div>
        <div class="ms-stat"><div class="ms-stat-num" style="color:var(--gold)">${data.overall_grade || '—'}</div><div class="ms-stat-lbl">Grade</div></div>
        <div class="ms-stat"><div class="ms-stat-num">${(data.results||[]).length}</div><div class="ms-stat-lbl">Questions</div></div>
      </div>
    </div>`;

  document.getElementById('marking-area').innerHTML = (data.results || []).map((r, i) => {
    const q = examQs[i] || {};
    const pctQ = r.marks_available ? Math.round((r.marks_awarded / r.marks_available) * 100) : 0;
    const pillClass = pctQ === 100 ? 'full' : pctQ >= 50 ? 'partial' : 'zero';
    const awarded = r.points_awarded || [];
    const missed = r.points_missed || [];

    return `<div class="mark-card">
      <div class="mark-card-head">
        <div>
          <div class="mark-q-label">Question ${r.q_num || i+1} — ${q.type || ''}</div>
          <div class="mark-q-text">${q.stem || ''}</div>
        </div>
        <span class="mark-score-pill ${pillClass}">${r.marks_awarded} / ${r.marks_available} marks</span>
      </div>
      <div class="mark-section">
        <div class="mark-section-lbl">Your answer</div>
        <div class="mark-student-ans">${(examAnswers[i] || '(no answer)').replace(/\n/g,'<br>')}</div>
      </div>
      ${awarded.length ? `<div class="mark-section">
        <div class="mark-section-lbl" style="color:#166534">✓ Mark points awarded</div>
        <div class="mark-scheme">${awarded.map(p => `• ${p}`).join('<br>')}</div>
      </div>` : ''}
      ${missed.length ? `<div class="mark-section">
        <div class="mark-section-lbl" style="color:#991B1B">✗ Points missed</div>
        <div style="font-size:13px;color:#991B1B;background:#FEF2F2;border:1px solid #FECACA;border-radius:var(--radius-sm);padding:8px 11px;line-height:1.5;">${missed.map(p => `• ${p}`).join('<br>')}</div>
      </div>` : ''}
      <div class="mark-section">
        <div class="mark-section-lbl">Examiner feedback</div>
        <div class="mark-feedback">${r.feedback || ''}</div>
      </div>
    </div>`;
  }).join('');

  document.getElementById('mark-advice-area').innerHTML = data.examiner_comments ? `
    <div class="mark-overall-advice">
      <div class="moa-label">Examiner's overall comments <button class="speak-btn" style="vertical-align:middle;margin-left:8px;background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:rgba(255,255,255,.7);" onclick="vbSpeak(${JSON.stringify(data.examiner_comments)})" aria-label="Read examiner comments aloud"><i class="ti ti-volume"></i> Read aloud</button></div>
      <div class="moa-text">${data.examiner_comments}</div>
    </div>` : '';
  // Auto-read overall grade if TTS on
  if (VB.ttsEnabled && data.total_awarded !== undefined) {
    const pct = data.total_available ? Math.round((data.total_awarded/data.total_available)*100) : 0;
    vbDoSpeak(`Marking complete. You scored ${data.total_awarded} out of ${data.total_available} marks, ${pct} percent. Grade: ${data.overall_grade || ''}. ${data.examiner_comments || ''}`);
  }
}

