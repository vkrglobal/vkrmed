async function startQuiz() {
  quizQs = []; quizIdx = 0; quizScore = 0; quizStreak = 0; quizAnswered = false;
  goScreen('s7');
  document.getElementById('quiz-topic-lbl').textContent = acadTopic;
  document.getElementById('quiz-score').textContent = '0';
  document.getElementById('quiz-streak').textContent = '0';
  document.getElementById('quiz-qtotal').textContent = '10';
  document.getElementById('quiz-area').innerHTML = '';
  document.getElementById('quiz-feedback').style.display = 'none';
  document.getElementById('quiz-nav').style.display = 'none';
  await fetchQuizBatch();
}

async function fetchQuizBatch() {
  document.getElementById('quiz-loading').style.display = 'block';
  document.getElementById('quiz-area').innerHTML = '';

  const isSchool = learnerTrack === 'school';
  const boardDesc = isSchool
    ? `${acadBoard} (subject: ${schoolSubject}, year: ${schoolYear})`
    : acadBoard;
  const levelDesc = isSchool ? schoolYear : (acadLevel || 'university');
  const subjectCtx = isSchool ? `Subject: ${schoolSubject}. ` : 'Medical subject. ';

  const sys = `You are an exam question generator for VKRMed by VKR Global. ${subjectCtx}Exam board: ${boardDesc}. Level: ${levelDesc}. Location: ${(GEO[geo] || GEO.other).label}.
Generate exactly 10 multiple-choice quiz questions on the topic provided, styled authentically to the ${boardDesc} specification.
${isSchool ? `Questions MUST match the exact syllabus content, terminology and command words used by ${acadBoard}. Use age-appropriate language for ${schoolYear} students. Include both recall and application questions in the ratio typical of this board.` : `Questions MUST reflect the clinical style, vignette format and difficulty of ${acadBoard}. Include pathophysiology, clinical presentation, investigations and management questions.`}
Each question must have exactly 4 options (A–D), one correct answer, and a brief explanation.
Vary difficulty: 3 easy, 4 medium, 3 hard. Points: easy=5pts, medium=10pts, hard=15pts.
Return ONLY valid JSON, no markdown:
{"questions":[{"q":"question text","options":["A. ...","B. ...","C. ...","D. ..."],"correct":0,"explanation":"clear explanation — why correct, what each distractor tests","points":10}]}`;

  try {
    const res = await fetch('/api/anthropic', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 4000, system: sys,
        messages: [{ role: 'user', content: `Generate 10 quiz questions on: ${acadTopic}. Board: ${boardDesc}. Level: ${levelDesc}. ${subjectCtx}` }] })
    });
    const d = await res.json();
    const raw = d.content.map(b => b.text || '').join('');
    let p = robustParse(raw);
    document.getElementById('quiz-loading').style.display = 'none';
    if (!p || !p.questions || !p.questions.length) {
      document.getElementById('quiz-area').innerHTML = '<div class="error-msg">Could not load questions. Please try again.</div>';
      return;
    }
    quizQs = p.questions;
    document.getElementById('quiz-qtotal').textContent = quizQs.length;
    renderQuizQ();
  } catch {
    document.getElementById('quiz-loading').style.display = 'none';
    document.getElementById('quiz-area').innerHTML = '<div class="error-msg">Connection error. Please try again.</div>';
  }
}

function renderQuizQ() {
  if (quizIdx >= quizQs.length) { showQuizResults(); return; }
  const q = quizQs[quizIdx];
  quizAnswered = false;
  const pct = Math.round((quizIdx / quizQs.length) * 100);
  document.getElementById('quiz-prog').style.width = pct + '%';
  document.getElementById('quiz-qnum').textContent = quizIdx + 1;
  document.getElementById('quiz-feedback').style.display = 'none';
  document.getElementById('quiz-nav').style.display = 'none';

  const letters = ['A','B','C','D'];
  document.getElementById('quiz-area').innerHTML = `
    <div class="quiz-q-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <span style="font-size:11px;color:var(--text-muted);font-weight:500;">Question ${quizIdx+1} of ${quizQs.length}</span>
        <span style="font-size:11px;font-weight:600;color:var(--teal);">+${q.points || 10} pts</span>
      </div>
      <div class="quiz-q-text">${q.q}</div>
      <div class="quiz-opts">
        ${q.options.map((o, i) => `
          <button class="quiz-opt" data-idx="${i}" onclick="answerQuiz(this, ${i}, ${q.correct}, ${q.points||10})">
            <span class="quiz-opt-letter">${letters[i]}</span>
            <span>${o.replace(/^[A-D]\.\s*/,'')}</span>
          </button>`).join('')}
      </div>
    </div>`;
}

function answerQuiz(btn, chosen, correct, pts) {
  if (quizAnswered) return;
  quizAnswered = true;
  const q = quizQs[quizIdx];
  const opts = document.querySelectorAll('.quiz-opt');
  opts.forEach(b => b.disabled = true);

  const isCorrect = chosen === correct;
  btn.classList.add(isCorrect ? 'correct' : 'wrong');
  opts[correct].classList.add(isCorrect ? 'correct' : 'reveal');

  if (isCorrect) {
    quizScore += pts;
    quizStreak++;
    const bonus = quizStreak >= 3 ? Math.floor(pts * 0.5) : 0;
    if (bonus) quizScore += bonus;
    document.getElementById('quiz-score').textContent = quizScore;
    document.getElementById('quiz-streak').textContent = quizStreak;
  } else {
    quizStreak = 0;
    document.getElementById('quiz-streak').textContent = '0';
  }

  const fb = document.getElementById('quiz-feedback');
  fb.className = 'quiz-feedback-box ' + (isCorrect ? 'correct' : 'wrong');
  const streakMsg = (isCorrect && quizStreak >= 3) ? ` 🔥 ${quizStreak} streak — bonus ${Math.floor(pts*0.5)} pts!` : '';
  const fbText = `${isCorrect ? 'Correct!' : 'Incorrect.'} ${q.explanation || ''}`;
  fb.innerHTML = `<strong>${isCorrect ? '✓ Correct!' : '✗ Incorrect.'}</strong>${streakMsg}<br>${q.explanation || ''}<br><button class="speak-btn" style="margin-top:6px" onclick="vbSpeak(${JSON.stringify(fbText)})" aria-label="Read feedback aloud"><i class="ti ti-volume"></i> Read feedback</button>`;
  fb.style.display = 'block';
  vbAutoReadFeedback(fbText);
  document.getElementById('quiz-nav').style.display = 'flex';

  const nextBtn = document.getElementById('btn-quiz-next');
  if (nextBtn) nextBtn.textContent = quizIdx + 1 >= quizQs.length ? 'See results →' : 'Next question →';
}

function nextQuizQ() {
  quizIdx++;
  renderQuizQ();
}

function showQuizResults() {
  document.getElementById('quiz-prog').style.width = '100%';
  const total = quizQs.reduce((s, q) => s + (q.points || 10), 0);
  const pct = Math.round((quizScore / total) * 100);
  let grade, gradeColor;
  if (pct >= 80) { grade = 'Distinction'; gradeColor = '#16A34A'; }
  else if (pct >= 65) { grade = 'Merit'; gradeColor = var_teal(); }
  else if (pct >= 50) { grade = 'Pass'; gradeColor = '#D97706'; }
  else { grade = 'Needs revision'; gradeColor = '#DC2626'; }

  document.getElementById('quiz-area').innerHTML = `
    <div class="quiz-results-card">
      <div style="font-size:13px;color:rgba(255,255,255,.6);margin-bottom:6px;">Quiz complete — ${acadTopic}</div>
      <div class="qrc-score">${quizScore}</div>
      <div class="qrc-label">points earned out of ${total}</div>
      <div class="qrc-grade" style="color:${gradeColor}">${grade} — ${pct}%</div>
      <div class="qrc-breakdown">
        <div class="qrc-stat"><div class="qrc-stat-num">${quizQs.length}</div><div class="qrc-stat-lbl">Questions</div></div>
        <div class="qrc-stat"><div class="qrc-stat-num" style="color:var(--gold)">${quizStreak}</div><div class="qrc-stat-lbl">Best streak</div></div>
        <div class="qrc-stat"><div class="qrc-stat-num">${pct}%</div><div class="qrc-stat-lbl">Score</div></div>
      </div>
    </div>`;
  document.getElementById('quiz-feedback').style.display = 'none';
  document.getElementById('quiz-nav').innerHTML = `
    <button class="btn-primary" onclick="startQuiz()">Retry quiz →</button>
    <button class="btn-secondary" onclick="goScreen('s6')">Try exam mode</button>
    <button class="btn-secondary" onclick="goScreen('s5')">← Back to analysis</button>`;
  document.getElementById('quiz-nav').style.display = 'flex';
}
function var_teal() { return '#0D7A6B'; }

