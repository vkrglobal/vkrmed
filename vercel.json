// ── DRUG COMPARISON MODULE ──
// ══════════════════════════════════════════════

let dcDrugs = [];          // current drug list
let dcFiltered = [];       // after filter
let dcCurrentSort = 'score';
let dcCurrentFilter = 'all';
let dcFeedbackDrug = null;
let dcFeedbackStar = 0;
let dcFeedbackTags = [];
let dcConditionName = '';
let dcUserRatings = {};    // drug name → {count, total, tags}

// ── Score a drug (0–100) from its fields ──────
function dcScore(d) {
  const evidenceScore = { A: 35, B: 22, C: 10 }[d.evidence_grade] || 10;
  const costScore     = { low: 30, medium: 20, high: 8 }[d.cost_tier] || 15;
  const userScore     = dcUserScore(d.name) * 0.35;   // up to 35 pts from user ratings
  return Math.round(evidenceScore + costScore + userScore);
}

function dcUserScore(name) {
  const r = dcUserRatings[name];
  if (!r || !r.count) return 20; // neutral default
  return (r.total / r.count) * 7; // 0–5 stars * 7 = 0–35
}

// ── Render the entry panel in S5 ─────────────
function renderDrugPanel(drugs, conditionName) {
  dcDrugs = drugs || [];
  dcConditionName = conditionName || '';
  const el = document.getElementById('drug-compare-area');
  if (!el || !dcDrugs.length) { if (el) el.innerHTML = ''; return; }

  const chips = dcDrugs.slice(0, 6).map(d =>
    `<div class="dep-drug-chip" onclick="launchDrugCompare()">
      <i class="ti ${d.type === 'branded' ? 'ti-shield-check' : 'ti-leaf'}" aria-hidden="true"></i>
      ${d.name}
    </div>`).join('');

  el.innerHTML = `
    <div class="drug-entry-panel">
      <div class="dep-header">
        <div class="dep-header-left">
          <i class="ti ti-pill" style="font-size:18px;color:var(--gold);"></i>
          <div>
            <div class="dep-header-title">Drug Comparison — ${conditionName}</div>
            <div style="font-size:11px;color:rgba(255,255,255,.45);">Branded vs generic · Cost · Evidence · User ratings</div>
          </div>
        </div>
        <div class="dep-badges">
          <span class="dep-badge">${dcDrugs.length} options</span>
          <span class="dep-badge">Rate & compare</span>
        </div>
      </div>
      <div class="dep-body">
        ${chips}
        <div class="dep-drug-chip" style="border-style:dashed;color:var(--teal);" onclick="launchDrugCompare()">
          <i class="ti ti-arrow-right" aria-hidden="true"></i> Compare all →
        </div>
      </div>
    </div>`;
}

function launchDrugCompare() {
  // Load stored ratings from persistent storage
  loadDcRatings().then(() => {
    renderDcScreen();
    goScreen('s11');
  });
}

// ── Persistent storage for user ratings ───────
async function loadDcRatings() {
  try {
    const res = await window.storage.get('dc-ratings-' + sanitiseKey(dcConditionName));
    if (res) dcUserRatings = JSON.parse(res.value);
  } catch { dcUserRatings = {}; }
}

async function saveDcRatings() {
  try {
    await window.storage.set('dc-ratings-' + sanitiseKey(dcConditionName), JSON.stringify(dcUserRatings));
  } catch {}
}

function sanitiseKey(s) {
  return (s || 'general').toLowerCase().replace(/[^a-z0-9]/g, '-').slice(0, 60);
}

// ── Render the full comparison screen ─────────
function renderDcScreen() {
  document.getElementById('dc-title').textContent = 'Drug Comparison — ' + dcConditionName;
  document.getElementById('dc-subtitle').textContent =
    `${dcDrugs.length} options · branded vs generic · cost · evidence · ${totalRatings()} user ratings`;
  dcCurrentSort = 'score'; dcCurrentFilter = 'all';
  document.querySelectorAll('.dc-sort-btn').forEach(b => b.classList.toggle('active', b.dataset.sort === 'score'));
  document.querySelectorAll('.dc-filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === 'all'));
  dcApplyFilterSort();
}

function totalRatings() {
  return Object.values(dcUserRatings).reduce((s, r) => s + (r.count || 0), 0);
}

function dcSort(btn, key) {
  document.querySelectorAll('.dc-sort-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  dcCurrentSort = key;
  dcApplyFilterSort();
}

function dcFilter(btn, key) {
  document.querySelectorAll('.dc-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  dcCurrentFilter = key;
  dcApplyFilterSort();
}

function dcApplyFilterSort() {
  let list = [...dcDrugs];
  if (dcCurrentFilter !== 'all') list = list.filter(d => d.type === dcCurrentFilter);

  list.sort((a, b) => {
    if (dcCurrentSort === 'score')    return dcScore(b) - dcScore(a);
    if (dcCurrentSort === 'cost')     return ['low','medium','high'].indexOf(a.cost_tier) - ['low','medium','high'].indexOf(b.cost_tier);
    if (dcCurrentSort === 'rating')   return dcUserScore(b.name) - dcUserScore(a.name);
    if (dcCurrentSort === 'evidence') return 'ABC'.indexOf(a.evidence_grade) - 'ABC'.indexOf(b.evidence_grade);
    return 0;
  });

  dcFiltered = list;
  renderDcCards(list);
}

function renderDcCards(list) {
  const area = document.getElementById('dc-cards-area');
  if (!list.length) {
    area.innerHTML = '<p style="font-size:13px;color:var(--text-muted);padding:20px 0;">No drugs match the current filter.</p>';
    return;
  }

  const winner = list[0];
  const winnerHTML = `
    <div class="dc-winner-banner">
      <i class="ti ti-trophy" aria-hidden="true"></i>
      <div><strong>${winner.name}</strong> ranks highest for this sort — ${winner.evidence_grade === 'A' ? 'Grade A evidence' : 'strong evidence'}, ${winner.cost_tier} cost, ${dcStarsHtml(dcUserScore(winner.name)/7)} user-rated.</div>
    </div>`;

  area.innerHTML = winnerHTML + list.map(d => dcCardHTML(d)).join('');
}

function dcStarsHtml(rating) {
  const r = Math.round(rating * 2) / 2;
  return `<span class="dc-stars">${'★'.repeat(Math.floor(r))}${'☆'.repeat(5 - Math.floor(r))}</span>`;
}

function dcBarHTML(value, max, color) {
  const pct = Math.round((value / max) * 100);
  return `<div class="dc-bar-wrap"><div class="dc-bar" style="width:${pct}%;background:${color};"></div></div>`;
}

function dcCardHTML(d) {
  const score = dcScore(d);
  const ur = dcUserRatings[d.name];
  const userRating = ur && ur.count ? (ur.total / ur.count).toFixed(1) : null;
  const userCount = ur ? ur.count : 0;
  const userTags = ur ? (ur.tags || []).slice(0, 4) : [];

  const costColors = { low: '#16A34A', medium: '#D97706', high: '#DC2626' };
  const costBars   = { low: 33, medium: 66, high: 100 };
  const evidColors = { A: '#16A34A', B: '#1D4ED8', C: '#D97706' };
  const evidBars   = { A: 100, B: 66, C: 33 };

  const pros = (d.pros || []).map(p => `<div class="dc-pro-item">${p}</div>`).join('');
  const cons = (d.cons || []).map(c => `<div class="dc-con-item">${c}</div>`).join('');

  const reviewStrip = userTags.length
    ? `<div class="dc-review-tags">${userTags.map(t => `<span class="dc-review-tag">${t}</span>`).join('')}</div>`
    : `<div style="font-size:11px;color:var(--text-muted);">No user reviews yet — be the first</div>`;

  return `
    <div class="dc-card" data-type="${d.type}">
      <div class="dc-card-header">
        <div class="dc-drug-icon ${d.type}">
          <i class="ti ${d.type === 'branded' ? 'ti-shield-check' : 'ti-leaf'}" aria-hidden="true"></i>
        </div>
        <div style="flex:1">
          <div class="dc-drug-name">${d.name}</div>
          <div class="dc-drug-generic">${d.active_ingredient || ''} · ${d.indication || ''}</div>
          <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:4px;">
            <span class="dc-type-badge ${d.type}">${d.type === 'branded' ? 'Branded' : d.type === 'generic' ? 'Generic' : 'OTC'}</span>
            <span class="dc-evidence ${d.evidence_grade}">Grade ${d.evidence_grade || 'B'}</span>
            <span style="font-size:11px;color:var(--text-muted);">${d.availability || ''}</span>
          </div>
        </div>
        <div class="dc-score-col">
          <div class="dc-overall-score">${score}</div>
          <div class="dc-score-label">/ 100</div>
        </div>
      </div>

      <div class="dc-metrics">
        <div class="dc-metric">
          <div class="dc-metric-label">Cost</div>
          <div class="dc-metric-value" style="color:${costColors[d.cost_tier]}">${d.cost_tier?.toUpperCase() || '—'}</div>
          <div class="dc-metric-sub">${d.cost_example || ''}</div>
          ${dcBarHTML(costBars[d.cost_tier] || 50, 100, costColors[d.cost_tier] || '#CBD5E0')}
        </div>
        <div class="dc-metric">
          <div class="dc-metric-label">Evidence</div>
          <div class="dc-metric-value" style="color:${evidColors[d.evidence_grade]}">Grade ${d.evidence_grade || 'B'}</div>
          <div class="dc-metric-sub">${d.evidence_grade === 'A' ? 'Strong RCT evidence' : d.evidence_grade === 'B' ? 'Good clinical evidence' : 'Limited evidence'}</div>
          ${dcBarHTML(evidBars[d.evidence_grade] || 50, 100, evidColors[d.evidence_grade] || '#CBD5E0')}
        </div>
        <div class="dc-metric">
          <div class="dc-metric-label">User rating</div>
          <div class="dc-metric-value">${userRating ? dcStarsHtml(parseFloat(userRating)) + ' ' + userRating : '—'}</div>
          <div class="dc-metric-sub">${userCount ? userCount + ' rating' + (userCount > 1 ? 's' : '') : 'No ratings yet'}</div>
          ${dcBarHTML(userRating ? parseFloat(userRating) * 20 : 0, 100, '#C9A84C')}
        </div>
        <div class="dc-metric">
          <div class="dc-metric-label">Overall score</div>
          <div class="dc-metric-value" style="color:var(--navy)">${score} / 100</div>
          <div class="dc-metric-sub">Evidence + cost + ratings</div>
          ${dcBarHTML(score, 100, 'var(--teal)')}
        </div>
      </div>

      <div class="dc-card-body">
        <div class="dc-pros-cons">
          <div class="dc-pro-con-col">
            <div class="dc-pro-con-label pros">Advantages</div>
            ${pros || '<div class="dc-pro-item">No data</div>'}
          </div>
          <div class="dc-pro-con-col">
            <div class="dc-pro-con-label cons">Considerations</div>
            ${cons || '<div class="dc-con-item">No data</div>'}
          </div>
        </div>
      </div>

      <div class="dc-reviews">
        ${reviewStrip}
        <button class="dc-rate-btn" onclick="dcOpenFeedback('${d.name.replace(/'/g,"\\'")}')">
          <i class="ti ti-star" style="font-size:12px;vertical-align:-1px;margin-right:3px;" aria-hidden="true"></i>
          Rate this drug
        </button>
      </div>
    </div>`;
}

// ── Feedback flow ─────────────────────────────
function dcOpenFeedback(drugName) {
  dcFeedbackDrug = drugName;
  dcFeedbackStar = 0;
  dcFeedbackTags = [];
  document.getElementById('dc-feedback-drug').textContent = drugName;
  document.getElementById('dc-feedback-text').value = '';
  document.querySelectorAll('.dc-star').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.dc-exp-tag').forEach(t => t.classList.remove('active'));
  document.getElementById('dc-feedback-panel').style.display = 'block';
  document.getElementById('dc-feedback-panel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function dcSetStar(n) {
  dcFeedbackStar = n;
  document.querySelectorAll('.dc-star').forEach(s => {
    s.classList.toggle('active', parseInt(s.dataset.val) <= n);
  });
}

function dcToggleTag(btn) {
  btn.classList.toggle('active');
  const tag = btn.textContent;
  if (btn.classList.contains('active')) { if (!dcFeedbackTags.includes(tag)) dcFeedbackTags.push(tag); }
  else dcFeedbackTags = dcFeedbackTags.filter(t => t !== tag);
}

async function dcSubmitFeedback() {
  if (!dcFeedbackStar) { alert('Please select a star rating first.'); return; }
  const drug = dcFeedbackDrug;
  if (!dcUserRatings[drug]) dcUserRatings[drug] = { count: 0, total: 0, tags: [] };
  dcUserRatings[drug].count++;
  dcUserRatings[drug].total += dcFeedbackStar;
  dcFeedbackTags.forEach(t => {
    if (!dcUserRatings[drug].tags.includes(t)) dcUserRatings[drug].tags.push(t);
  });
  await saveDcRatings();
  document.getElementById('dc-feedback-panel').style.display = 'none';
  dcFeedbackStar = 0; dcFeedbackTags = []; dcFeedbackDrug = null;
  dcApplyFilterSort(); // re-render with updated ratings
  // Show confirmation
  const area = document.getElementById('dc-cards-area');
  const toast = document.createElement('div');
  toast.style.cssText = 'background:#F0FDF4;border:1px solid #BBF7D0;border-radius:8px;padding:10px 14px;font-size:13px;color:#166534;margin-bottom:12px;';
  toast.textContent = `✓ Rating submitted for ${drug}. Thank you!`;
  area.prepend(toast);
  setTimeout(() => toast.remove(), 3000);
}

// ── Hook into renderResults ────────────────────
// Called after renderResults processes analysis data
function renderDrugPanelFromAnalysis(data) {
  const topCondition = data.conditions && data.conditions[0];
  if (!topCondition) return;
  const drugs = data.drug_options || [];
  renderDrugPanel(drugs, topCondition.name);
}

// ══════════════════════════════════════════════
// ── VOICE MODULE ──
// Speech Recognition (input) + Web Speech TTS (output)
// ══════════════════════════════════════════════

const VB = {
  inputEnabled: false,
  ttsEnabled: false,
  recognition: null,
  currentRecordingTarget: null,
  currentMicBtn: null,
  speaking: false,
  speed: 1.0,
  selectedVoice: null,
  voices: [],
  supported: {
    recognition: !!(window.SpeechRecognition || window.webkitSpeechRecognition),
    tts: !!window.speechSynthesis,
  },
};

// ── Init ─────────────────────────────────────
function vbInit() {
  if (!VB.supported.recognition && !VB.supported.tts) {
    document.getElementById('vb-status').textContent = 'Voice not supported in this browser';
    return;
  }
  // Populate voice selector
  if (VB.supported.tts) {
    const loadVoices = () => {
      VB.voices = window.speechSynthesis.getVoices().filter(v =>
        v.lang.startsWith('en') || v.lang.startsWith('zh') || v.lang.startsWith('ms')
      );
      const sel = document.getElementById('vb-voice');
      if (sel) {
        sel.innerHTML = '<option value="">Default</option>' +
          VB.voices.map((v, i) => `<option value="${i}">${v.name} (${v.lang})</option>`).join('');
      }
    };
    window.speechSynthesis.onvoiceschanged = loadVoices;
    loadVoices();
  }
  // Setup recognition
  if (VB.supported.recognition) {
    const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
    VB.recognition = new SpeechRec();
    VB.recognition.continuous = false;
    VB.recognition.interimResults = true;
    VB.recognition.lang = 'en-GB';

    VB.recognition.onresult = (e) => {
      const transcript = Array.from(e.results).map(r => r[0].transcript).join('');
      const isFinal = e.results[e.results.length - 1].isFinal;
      // Show interim in transcript strip
      const stripId = 'transcript-' + VB.currentRecordingTarget;
      const strip = document.getElementById(stripId);
      if (strip) {
        strip.style.display = 'flex';
        const textEl = document.getElementById(stripId + '-text');
        if (textEl) textEl.textContent = transcript;
      }
      if (isFinal) {
        const target = document.getElementById(VB.currentRecordingTarget);
        if (target) {
          // Append to existing text if there's content
          const existing = target.value.trim();
          target.value = existing ? existing + ' ' + transcript : transcript;
          target.dispatchEvent(new Event('input', { bubbles: true }));
        }
        vbStopRecording();
        vbToast('✓ Voice captured');
      }
    };
    VB.recognition.onerror = (e) => {
      vbStopRecording();
      if (e.error !== 'no-speech') vbToast('Voice error: ' + e.error);
    };
    VB.recognition.onend = () => { vbStopRecording(); };
  }
}

// ── Voice bar toggles ─────────────────────────
function vbToggleInput() {
  if (!VB.supported.recognition) {
    vbToast('Speech recognition not supported in this browser. Use Chrome or Edge.');
    return;
  }
  VB.inputEnabled = !VB.inputEnabled;
  const btn = document.getElementById('vb-input-toggle');
  const lbl = document.getElementById('vb-input-label');
  const ico = document.getElementById('vb-input-icon');
  btn.classList.toggle('active', VB.inputEnabled);
  lbl.textContent = VB.inputEnabled ? 'Voice input: On' : 'Voice input: Off';
  ico.className = VB.inputEnabled ? 'ti ti-microphone-filled' : 'ti ti-microphone';
  if (!VB.inputEnabled) vbStopRecording();
  vbToast(VB.inputEnabled ? '🎤 Voice input enabled — tap any mic button to speak' : 'Voice input disabled');
}

function vbToggleTTS() {
  if (!VB.supported.tts) {
    vbToast('Text-to-speech not supported in this browser.');
    return;
  }
  VB.ttsEnabled = !VB.ttsEnabled;
  const btn = document.getElementById('vb-tts-toggle');
  const lbl = document.getElementById('vb-tts-label');
  const ico = document.getElementById('vb-tts-icon');
  const speedWrap = document.getElementById('vb-speed-wrap');
  btn.classList.toggle('active', VB.ttsEnabled);
  lbl.textContent = VB.ttsEnabled ? 'Read aloud: On' : 'Read aloud: Off';
  ico.className = VB.ttsEnabled ? 'ti ti-volume-filled' : 'ti ti-volume';
  speedWrap.style.display = VB.ttsEnabled ? 'flex' : 'none';
  speedWrap.style.alignItems = 'center';
  speedWrap.style.gap = '6px';
  if (!VB.ttsEnabled) vbStopSpeaking();
  vbToast(VB.ttsEnabled ? '🔊 Read aloud enabled — responses will be spoken' : 'Read aloud disabled');
}

function vbSetSpeed(v) { VB.speed = parseFloat(v) || 1.0; }
function vbSetVoice(v) {
  VB.selectedVoice = v !== '' ? VB.voices[parseInt(v)] : null;
}

// ── Recording ─────────────────────────────────
function vbStartRecording(targetId, btn) {
  if (!VB.supported.recognition) {
    vbToast('Speech recognition not supported. Please use Chrome or Edge on desktop.');
    return;
  }
  if (!VB.inputEnabled) {
    vbToast('Enable voice input first using the Voice bar above.');
    return;
  }
  // Stop any existing recording
  if (VB.currentRecordingTarget) vbStopRecording();

  VB.currentRecordingTarget = targetId;
  VB.currentMicBtn = btn;
  btn.classList.add('recording');
  btn.innerHTML = '<i class="ti ti-microphone-filled"></i> Listening…';

  // Show transcript strip
  const stripId = 'transcript-' + targetId;
  const strip = document.getElementById(stripId);
  if (strip) {
    strip.style.display = 'flex';
    const textEl = document.getElementById(stripId + '-text');
    if (textEl) textEl.textContent = 'Listening…';
  }

  document.getElementById('vb-status').textContent = '🔴 Recording…';

  try { VB.recognition.start(); }
  catch(e) {
    // Already started — abort and restart
    VB.recognition.abort();
    setTimeout(() => { try { VB.recognition.start(); } catch(e2) {} }, 300);
  }
}

function vbStopRecording() {
  if (VB.recognition) { try { VB.recognition.stop(); } catch(e) {} }
  if (VB.currentMicBtn) {
    VB.currentMicBtn.classList.remove('recording');
    // Restore mic button content
    const wasInline = VB.currentMicBtn.classList.contains('mic-btn-inline');
    VB.currentMicBtn.innerHTML = wasInline
      ? '<i class="ti ti-microphone"></i> Speak'
      : '<i class="ti ti-microphone"></i>';
  }
  VB.currentMicBtn = null;
  VB.currentRecordingTarget = null;
  document.getElementById('vb-status').textContent = '';
}

// ── TTS ────────────────────────────────────────
function vbSpeak(text) {
  if (!VB.supported.tts) { vbToast('Text-to-speech not supported in this browser.'); return; }
  if (!VB.ttsEnabled) {
    // Allow manual speak even if auto is off
    vbDoSpeak(text);
    return;
  }
  vbDoSpeak(text);
}

function vbDoSpeak(text) {
  if (!text || !text.trim()) return;
  vbStopSpeaking();
  // Clean text — strip HTML tags, ICD codes, markdown
  const clean = text.replace(/<[^>]+>/g,'').replace(/[A-Z]\d+(\.\d+)*/g,'').replace(/\s+/g,' ').trim();
  const utt = new SpeechSynthesisUtterance(clean);
  utt.rate = VB.speed;
  utt.pitch = 1.0;
  if (VB.selectedVoice) utt.voice = VB.selectedVoice;
  utt.onstart = () => {
    VB.speaking = true;
    document.getElementById('vb-stop-btn').style.display = 'flex';
    document.getElementById('vb-status').textContent = '🔊 Speaking…';
  };
  utt.onend = utt.onerror = () => {
    VB.speaking = false;
    document.getElementById('vb-stop-btn').style.display = 'none';
    document.getElementById('vb-status').textContent = '';
  };
  window.speechSynthesis.speak(utt);
}

function vbStopSpeaking() {
  if (VB.supported.tts) window.speechSynthesis.cancel();
  VB.speaking = false;
  const stopBtn = document.getElementById('vb-stop-btn');
  if (stopBtn) stopBtn.style.display = 'none';
  const status = document.getElementById('vb-status');
  if (status) status.textContent = '';
}

// ── Auto-read results if TTS is on ────────────
function vbAutoReadResults(data) {
  if (!VB.ttsEnabled || !VB.supported.tts) return;
  const top = data.conditions && data.conditions[0];
  const parts = [
    data.urgency_message || '',
    top ? `Most likely condition: ${top.name}. ${top.summary || ''}` : '',
    data.key_advice || '',
  ].filter(Boolean).join('. ');
  setTimeout(() => vbDoSpeak(parts), 600);
}

// ── Quiz feedback auto-read ───────────────────
function vbAutoReadFeedback(text) {
  if (!VB.ttsEnabled || !VB.supported.tts) return;
  setTimeout(() => vbDoSpeak(text), 300);
}

// ── Toast ─────────────────────────────────────
let vbToastTimer = null;
function vbToast(msg) {
  let t = document.getElementById('vb-toast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'vb-toast';
    t.className = 'voice-toast';
    document.body.appendChild(t);
  }
  t.innerHTML = `<i class="ti ti-microphone" aria-hidden="true"></i> ${msg}`;
  t.style.display = 'flex';
  clearTimeout(vbToastTimer);
  vbToastTimer = setTimeout(() => { t.style.display = 'none'; }, 3000);
}

// ── Initialise on load ────────────────────────
document.addEventListener('DOMContentLoaded', vbInit);
// Fallback if DOM already loaded
if (document.readyState !== 'loading') vbInit();

</script>
</body>
</html>
