        <div style="display:flex;gap:6px;margin-bottom:10px;" id="dc-star-row">
          <span style="font-size:12px;color:var(--text-muted);align-self:center;">Your rating:</span>
          ${[1,2,3,4,5].map(n=>`<button class="dc-star" data-val="${n}" onclick="dcSetStar(${n})">★</button>`).join('')}
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;" id="dc-tag-row">
          <span style="font-size:12px;color:var(--text-muted);align-self:center;">Experience:</span>
          ${['Works well','Fast relief','Side effects','Cost-effective','Prefer branded','Prefer generic','Would recommend'].map(t=>`<button class="dc-exp-tag" onclick="dcToggleTag(this)">${t}</button>`).join('')}
        </div>
        <textarea id="dc-feedback-text" class="desc-input" rows="2" placeholder="Optional: describe your experience in a few words…" style="margin-bottom:8px;"></textarea>
        <div class="btn-row" style="margin-top:0;">
          <button class="btn-primary" onclick="dcSubmitFeedback()" style="font-size:12px;padding:8px 16px;">Submit rating</button>
          <button class="btn-secondary" onclick="document.getElementById('dc-feedback-panel').style.display='none'" style="font-size:12px;padding:8px 14px;">Cancel</button>
        </div>
      </div>
    </div>

    <div class="btn-row" style="margin-top:16px;">
      <button class="btn-secondary" onclick="goScreen('s5')">← Back to analysis</button>
    </div>
    <div class="disclaimer-sm">Drug pricing is indicative and may vary by retailer, region, and time. Branded names and generics may contain the same active ingredient at different prices. VKRMed does not endorse any specific product.</div>
  </div>

</main>

<!-- FOOTER -->
<footer class="site-footer">
  <span class="footer-brand"><strong>VKR Global</strong> · VKRMed Health Intelligence · Version 1.0</span>
  <a class="footer-link" href="https://vkrglobal.net" target="_blank" rel="noopener">vkrglobal.net ↗</a>
</footer>

<script>
// ── STATE ──
let persona = null, geo = null;
let selSyms = [], freeText = '';
let profAge = '', profSex = '', profCond = '';
let qaHistory = [], qNum = 0;
const MAX_QS = 4;

// Academic state
let acadMode = null, acadBoard = null, acadLevel = null, acadTopic = '';
let quizQs = [], quizIdx = 0, quizScore = 0, quizStreak = 0, quizAnswered = false;
let examQs = [], examAnswers = {};

// ── GEO DATA ──
const GEO = {
  uk: { label: 'United Kingdom', emergency: '999', nonEmergency: 'NHS 111', drug: 'paracetamol', guideline: 'NICE' },
  us: { label: 'United States', emergency: '911', nonEmergency: '811', drug: 'acetaminophen', guideline: 'ACP/USPSTF' },
  aus: { label: 'Australia / NZ', emergency: '000 / 111 (NZ)', nonEmergency: 'healthdirect 1800 022 222', drug: 'paracetamol', guideline: 'RACGP/NZGG' },
  sg: { label: 'Singapore', emergency: '995', nonEmergency: 'HealthHub / 1800 333 9999', drug: 'paracetamol', guideline: 'MOH Singapore' },
  eu: { label: 'Europe', emergency: '112', nonEmergency: 'local GP / out-of-hours', drug: 'paracetamol', guideline: 'EMA/ESCMID' },
  canada: { label: 'Canada', emergency: '911', nonEmergency: '811 (HealthLink)', drug: 'acetaminophen', guideline: 'CMA' },
  other: { label: 'Global', emergency: 'local emergency number', nonEmergency: 'local GP / urgent care', drug: 'paracetamol', guideline: 'WHO' }
};

const PERSONA_LABELS = { patient: 'Patient / Carer', professional: 'Medical Professional', student: 'Student / Researcher' };

const RESOURCES = {
  uk: [
    { i: 'ti-building-hospital', n: 'NHS 111', d: 'Non-emergency medical advice', u: 'https://111.nhs.uk/' },
    { i: 'ti-stethoscope', n: 'Find a GP – NHS', d: 'Locate your nearest GP surgery', u: 'https://www.nhs.uk/service-search/find-a-gp' },
    { i: 'ti-book', n: 'NHS Conditions A–Z', d: 'Clinician-reviewed condition guides', u: 'https://www.nhs.uk/conditions/' },
    { i: 'ti-pill', n: 'NHS Medicines A–Z', d: 'Evidence-based drug information', u: 'https://www.nhs.uk/medicines/' }
  ],
  us: [
    { i: 'ti-building-hospital', n: 'HealthCare.gov – Find Care', d: 'Locate local healthcare services', u: 'https://www.healthcare.gov/find-care/' },
    { i: 'ti-book', n: 'MedlinePlus (NIH)', d: 'NIH-backed condition and drug info', u: 'https://medlineplus.gov/' },
    { i: 'ti-stethoscope', n: 'CDC Health Topics', d: 'Public health guidance from the CDC', u: 'https://www.cdc.gov/az/index.html' },
    { i: 'ti-pill', n: 'DailyMed (NIH)', d: 'FDA drug labelling information', u: 'https://dailymed.nlm.nih.gov/' }
  ],
  aus: [
    { i: 'ti-building-hospital', n: 'healthdirect Australia', d: 'Australian government health advice', u: 'https://www.healthdirect.gov.au/' },
    { i: 'ti-book', n: 'Health Navigator NZ', d: 'New Zealand health information', u: 'https://www.healthnavigator.org.nz/' },
    { i: 'ti-stethoscope', n: 'Find a GP – healthdirect', d: 'Locate GP services in Australia', u: 'https://www.healthdirect.gov.au/australian-health-services' },
    { i: 'ti-pill', n: 'NPS MedicineWise', d: 'Independent Australian medicine info', u: 'https://www.nps.org.au/' }
  ],
  sg: [
    { i: 'ti-building-hospital', n: 'HealthHub Singapore', d: 'Official Singapore health portal', u: 'https://www.healthhub.sg/' },
    { i: 'ti-stethoscope', n: 'Find a GP – MOH', d: 'Singapore Ministry of Health GP finder', u: 'https://www.moh.gov.sg/' },
    { i: 'ti-book', n: 'SingHealth Patient Education', d: 'Condition guides from SingHealth', u: 'https://www.singhealth.com.sg/patient-care/patient-education' },
    { i: 'ti-phone', n: 'Health Advice Line', d: '1800-333-9999 — non-emergency advice', u: 'https://www.healthhub.sg/' }
  ],
  eu: [
    { i: 'ti-book', n: 'European Medicines Agency', d: 'EU-wide drug and safety information', u: 'https://www.ema.europa.eu/' },
    { i: 'ti-building-hospital', n: 'Patient.info', d: 'Clinician-reviewed condition guides', u: 'https://patient.info/' },
    { i: 'ti-stethoscope', n: 'WHO Health Topics', d: 'Global health guidance from the WHO', u: 'https://www.who.int/health-topics/' },
    { i: 'ti-pill', n: 'e-lactancia', d: 'Drug safety in pregnancy / lactation', u: 'https://www.e-lactancia.org/' }
  ],
  canada: [
    { i: 'ti-building-hospital', n: 'Health Canada', d: 'Official Canadian health guidance', u: 'https://www.canada.ca/en/health-canada.html' },
    { i: 'ti-stethoscope', n: '811 HealthLink', d: 'Provincial nurse advice line', u: 'https://www.canada.ca/en/public-health/services/health-promotion/healthy-living/provincial-territorial-health-authorities.html' },
    { i: 'ti-book', n: 'MedlinePlus (NIH)', d: 'NIH-backed condition and drug info', u: 'https://medlineplus.gov/' },
    { i: 'ti-pill', n: 'Health Canada Drug Database', d: 'Approved drug product information', u: 'https://www.canada.ca/en/health-canada/services/drugs-health-products/drug-products/drug-product-database.html' }
  ],
  other: [
    { i: 'ti-book', n: 'Patient.info', d: 'Clinician-reviewed condition guides', u: 'https://patient.info/' },
    { i: 'ti-stethoscope', n: 'WHO Health Topics', d: 'Global health guidance from WHO', u: 'https://www.who.int/health-topics/' },
    { i: 'ti-building-hospital', n: 'NHS Conditions A–Z', d: 'Internationally trusted clinical info', u: 'https://www.nhs.uk/conditions/' },
    { i: 'ti-pill', n: 'MedlinePlus (NIH)', d: 'NIH-backed condition and drug info', u: 'https://medlineplus.gov/' }
  ]
};

// ── PERSONA TAB SWITCH (header) ──
function switchTab(p) {
  ['patient','professional','student'].forEach(t => document.getElementById('ptab-' + t).classList.toggle('active', t === p));
  document.querySelectorAll('.persona-card-outer').forEach(c => { c.classList.toggle('sel', c.dataset.p === p); });
  persona = p;
  document.getElementById('btn-s1').disabled = false;
  const hint = document.getElementById('early-acad-hint');
  if (hint) hint.style.display = p === 'student' ? 'block' : 'none';
}

// ── SCREEN NAV ──
function goScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function goS2() {
  profAge = document.getElementById('prof-age').value;
  profSex = document.getElementById('prof-sex').value;
  profCond = document.getElementById('prof-cond').value;
  renderChips('chips-s2');
  goScreen('s2');
}
function goS3() {
  freeText = document.getElementById('free-text').value.trim();
  if (selSyms.length === 0 && !freeText) { document.getElementById('free-text').focus(); return; }
  qaHistory = []; qNum = 0;
  renderChips('chips-s3');
  goScreen('s3');
  fetchNextQ();
}

// ── PERSONA / GEO SELECT ──
function selPersona(el) {
  document.querySelectorAll('.persona-card-outer').forEach(c => c.classList.remove('sel'));
  el.classList.add('sel');
  persona = el.dataset.p;
  ['patient','professional','student'].forEach(t => document.getElementById('ptab-' + t).classList.toggle('active', t === persona));
  // Show early academic shortcut for students
  const hint = document.getElementById('early-acad-hint');
  if (hint) hint.style.display = persona === 'student' ? 'block' : 'none';
  checkS1();
}
function selGeo(el) {
  document.querySelectorAll('.g-btn').forEach(b => b.classList.remove('sel'));
  el.classList.add('sel'); geo = el.dataset.g; checkS1();
}
function checkS1() {
  document.getElementById('btn-s1').disabled = !(persona && geo);
}
function togSym(btn) {
  const s = btn.dataset.s;
  if (btn.classList.contains('sel')) { btn.classList.remove('sel'); selSyms = selSyms.filter(x => x !== s); }
  else { btn.classList.add('sel'); selSyms.push(s); }
}

// ── CHIPS ──
function renderChips(id) {
  const g = GEO[geo] || GEO.other;
  let h = `<span class="chip persona">${PERSONA_LABELS[persona]}</span><span class="chip geo">${g.label}</span>`;
  if (profAge) h += `<span class="chip profile">Age ${profAge}</span>`;
  if (profSex && profSex !== '') h += `<span class="chip profile">${profSex}</span>`;
  if (profCond) h += `<span class="chip profile">${profCond}</span>`;
  selSyms.forEach(s => h += `<span class="chip sym">${s}</span>`);
  document.getElementById(id).innerHTML = h;
}

// ── Q&A ──
function buildQSys() {
  const g = GEO[geo] || GEO.other;
  return `You are a medical triage assistant for VKRMed by VKR Global. The user is a ${persona} (${PERSONA_LABELS[persona]}) in ${g.label}. Age: ${profAge||'unknown'}, sex: ${profSex||'unspecified'}, existing conditions: ${profCond||'none stated'}. Generate ONE targeted follow-up question. ${persona==='professional'?'Use clinical terminology.':persona==='student'?'Frame with a learning angle.':'Use plain, reassuring language.'} Respond ONLY with valid JSON, no markdown: {"question":"...","options":["...","...","...","..."]}`;
}
function buildQUser() {
  let m = `Symptoms: ${selSyms.join(', ')||'see description'}.`;
  if (freeText) m += ` Description: "${freeText}".`;
  if (qaHistory.length) m += ` Prior Q&A: ${qaHistory.map(q=>`Q:${q.q} A:${q.a}`).join(' | ')}.`;
  m += ` This is question ${qNum+1} of ${MAX_QS}.`;
  return m;
}
async function fetchNextQ() {
  if (qNum >= MAX_QS) { skipToAnalysis(); return; }
  document.getElementById('qa-loading').style.display = 'block';
  document.getElementById('qa-area').innerHTML = '';
  try {
    const res = await fetch('/api/anthropic', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1500, system: buildQSys(), messages: [{ role: 'user', content: buildQUser() }] })
    });
    const d = await res.json();
    const raw = d.content.map(b => b.text || '').join('');
    let p = robustParse(raw);
    document.getElementById('qa-loading').style.display = 'none';
    if (!p || !p.question) { skipToAnalysis(); return; }
    renderQ(p); qNum++;
  } catch { document.getElementById('qa-loading').style.display = 'none'; skipToAnalysis(); }
}
function renderQ(p) {
  const pct = Math.round((qNum / MAX_QS) * 100);
  document.getElementById('prog').style.width = pct + '%';
  // Auto-read question if TTS enabled
  if (VB.ttsEnabled) setTimeout(() => vbDoSpeak(p.question), 400);
  document.getElementById('qa-area').innerHTML = `
    <div class="q-card">
      <div class="q-num" style="display:flex;align-items:center;justify-content:space-between;">
        <span>Question ${qNum+1} of ${MAX_QS}</span>
        <button class="speak-btn" onclick="vbSpeak(${JSON.stringify(p.question)})" aria-label="Read question aloud"><i class="ti ti-volume"></i> Hear</button>
      </div>
      <div class="q-text">${p.question}</div>
      <div class="q-opts">${p.options.map(o => `<button class="q-opt" onclick="ansQ(this,'${p.question.replace(/'/g,"\\'").replace(/"/g,"&quot;")}','${o.replace(/'/g,"\\'").replace(/"/g,"&quot;")}')"> ${o}</button>`).join('')}</div>
    </div>`;
}
async function ansQ(btn, q, a) {
  qaHistory.push({ q, a }); btn.classList.add('answered');
  document.querySelectorAll('.q-opt').forEach(b => { if (b !== btn) b.disabled = true; });
  await new Promise(r => setTimeout(r, 300));
  await fetchNextQ();
}
function skipToAnalysis() { goScreen('s4'); runAnalysis(); }

// ── ANALYSIS ──
function buildASys() {
  const g = GEO[geo] || GEO.other;
  const inst = {
    patient: `You are a medical information assistant for VKRMed by VKR Global, speaking to a patient/carer in ${g.label}. Plain English throughout. Reassuring but honest. Use local drug names (${g.drug}). Triage references use local emergency number (${g.emergency}) and non-emergency service (${g.nonEmergency}).`,
    professional: `You are a clinical decision support tool for VKRMed by VKR Global, used by a medical professional in ${g.label}. Precise clinical terminology. Include ICD-10 codes. Likelihood framing. Explicit red flag criteria. Reference ${g.guideline} guidelines.`,
    student: `You are a medical education assistant for VKRMed by VKR Global, used by a student/researcher in ${g.label}. Explain pathophysiology for each condition. Include landmark academic references. Suggest PubMed search terms. Frame as learning opportunities. Reference ${g.guideline} guidelines.`
  };
  return `${inst[persona]} Respond ONLY with valid JSON (no markdown):
{"urgency":"green"|"amber"|"red","urgency_message":"one sentence","subtitle":"one sentence","conditions":[{"name":"","icd10":"code or null","likelihood":"Most likely|Possible|Less common|Must exclude","severity":"info"|"warn"|"danger","summary":"2-3 sentences appropriate to persona","action_tags":[""],"tag_colors":["g"|"a"|"r"],"pubmed_search":"search terms if student else null","key_ref":"landmark ref if student else null"}],"key_advice":"2-3 sentences","research_topics":["topic1","topic2","topic3"],"drug_options":[{"name":"Brand name e.g. Beconase","active_ingredient":"e.g. beclometasone","type":"branded"|"generic"|"otc","indication":"what it treats in plain terms","evidence_grade":"A"|"B"|"C","cost_tier":"low"|"medium"|"high","cost_example":"e.g. £6.99 / 200 doses","availability":"e.g. OTC UK pharmacies","pros":["pro1","pro2","pro3"],"cons":["con1","con2"]}]}
Return 2-4 conditions. drug_options: 3-5 relevant OTC/prescription options for the most likely condition including at least one branded AND one generic/own-brand equivalent — e.g. Beconase vs Pirinase vs fexofenadine vs cetirizine own-brand. Include real drug names. research_topics: 3 items if student persona, else []. action_tags and tag_colors must be same length.`;
}
function buildAUser() {
  const g = GEO[geo] || GEO.other;
  let m = `Persona:${persona}. Location:${g.label}. Age:${profAge||'unknown'}. Sex:${profSex||'unspecified'}. Existing conditions:${profCond||'none'}. Symptoms:${selSyms.join(',')||'see description'}.`;
  if (freeText) m += ` Description:"${freeText}".`;
  if (qaHistory.length) m += ` Q&A:${qaHistory.map(q=>`Q:${q.q}→A:${q.a}`).join('|')}.`;
  m += ' Provide differential analysis.';
  return m;
}
const loadMsgs = ['Analysing your symptoms…','Checking red flags…','Compiling differential…','Searching guidelines…','Finalising analysis…'];
const loadSteps = [
  { label: 'Processing symptom inputs', icon: 'ti-clipboard-list' },
  { label: 'Checking red flag criteria', icon: 'ti-alert-triangle' },
  { label: 'Building differential diagnosis', icon: 'ti-git-branch' },
  { label: 'Applying clinical guidelines', icon: 'ti-book-2' },
  { label: 'Compiling recommendations', icon: 'ti-check' },
];
async function runAnalysis() {
  renderChips('chips-s4');
  let li = 0, si = 0;
  const iv = setInterval(() => {
    const el = document.getElementById('load-msg');
    if (el) el.textContent = loadMsgs[li++ % loadMsgs.length];
    const steps = document.getElementById('load-steps');
    if (steps && si < loadSteps.length) {
      const s = loadSteps[si++];
      const div = document.createElement('div');
      div.className = 'load-step done';
      div.innerHTML = `<i class="ti ${s.icon}" style="color:var(--teal)"></i><span>${s.label}</span>`;
      steps.appendChild(div);
    }
  }, 1100);
  try {
    const res = await fetch('/api/anthropic', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1500, system: buildASys(), messages: [{ role: 'user', content: buildAUser() }] })
    });
    clearInterval(iv);
    const d = await res.json();
    const raw = d.content.map(b => b.text || '').join('');
    let p = robustParse(raw);
    if (!p) { goScreen('s5'); document.getElementById('results-area').innerHTML = '<div style="color:#C0392B;font-size:13px;padding:12px;background:#FEF2F2;border-radius:8px">Could not parse response. Please try again.</div>'; return; }
    if (p.urgency === 'red') showOverlay();
    renderResults(p); goScreen('s5');
  } catch (e) {
    clearInterval(iv); goScreen('s5');
    document.getElementById('results-area').innerHTML = '<div style="color:#C0392B;font-size:13px;padding:12px;background:#FEF2F2;border-radius:8px">Connection error. Please try again.</div>';
  }
}

// ── EMERGENCY OVERLAY ──
function showOverlay() {
  const g = GEO[geo] || GEO.other;
  document.getElementById('ov-geo').textContent = g.label;
  document.getElementById('ov-num').textContent = g.emergency;
  document.getElementById('overlay').style.display = 'flex';
}
function closeOverlay(show) {
  document.getElementById('overlay').style.display = 'none';
  if (show) goScreen('s5');
}

// ── RENDER RESULTS ──
function renderResults(data) {
  const g = GEO[geo] || GEO.other;
  renderChips('chips-s5');
  document.getElementById('r-sub').textContent = data.subtitle || '';

  const urgIcons = { red: 'ti-alert-triangle', amber: 'ti-alert-circle', green: 'ti-circle-check' };
  const urg = data.urgency || 'green';
  document.getElementById('urgency-area').innerHTML = `<div class="urgency-banner ${urg}"><i class="ti ${urgIcons[urg]}"></i><div>${data.urgency_message || ''}<button class="speak-btn" style="margin-left:10px;vertical-align:middle" onclick="vbSpeak(${JSON.stringify(data.urgency_message||'')})" aria-label="Read aloud"><i class="ti ti-volume"></i> Hear</button></div></div>`;

  const imap = { info: 'ti-info-circle', warn: 'ti-alert-circle', danger: 'ti-alert-triangle' };
  document.getElementById('results-area').innerHTML = (data.conditions || []).map(c => {
    const icd = c.icd10 ? `<span class="icd-badge">${c.icd10}</span>` : '';
    const tags = (c.action_tags || []).map((t, i) => `<span class="tag ${(c.tag_colors || [])[i] || 'g'}">${t}</span>`).join('');
    const ref = (persona === 'student' && c.key_ref) ? `<div class="ref-line"><i class="ti ti-book-2" style="font-size:12px;vertical-align:-1px;margin-right:4px"></i>${c.key_ref}</div>` : '';
    const pm = (persona === 'student' && c.pubmed_search) ? `<a class="pubmed-link" href="https://pubmed.ncbi.nlm.nih.gov/?term=${encodeURIComponent(c.pubmed_search)}&sort=date" target="_blank" rel="noopener"><i class="ti ti-search" style="font-size:11px"></i>Search PubMed</a>` : '';
    const speakText = `${c.name}. ${c.likelihood||''}. ${c.summary||''}`;
    return `<div class="result-card"><div class="rc-head"><div class="rc-icon ${c.severity||'info'}"><i class="ti ${imap[c.severity||'info']}"></i></div><div style="flex:1"><div class="rc-title">${c.name}${icd}</div><div class="rc-likelihood">${c.likelihood||''}</div></div><button class="speak-btn" onclick="vbSpeak(${JSON.stringify(speakText)})" aria-label="Read aloud"><i class="ti ti-volume"></i></button></div><div class="rc-body">${c.summary||''}</div><div class="tags">${tags}</div>${ref}${pm}</div>`;
  }).join('');

  if (data.key_advice) {
    document.getElementById('advice-area').innerHTML = `<div class="advice-box"><div class="advice-label">Key advice <button class="speak-btn" style="vertical-align:middle;margin-left:8px" onclick="vbSpeak(${JSON.stringify(data.key_advice)})" aria-label="Read aloud"><i class="ti ti-volume"></i> Read aloud</button></div><div class="advice-text">${data.key_advice}</div></div>`;
  }
  renderDrugPanelFromAnalysis(data);
  vbAutoReadResults(data);

  if (persona === 'student' && data.research_topics && data.research_topics.length) {
    const icons = ['pm','mx','cr'];
    const iconClass = ['ti-dna','ti-file-text','ti-clipboard-list'];
    document.getElementById('research-area').innerHTML = `
      <div class="research-panel">
        <div class="rp-header">
          <i class="ti ti-microscope" style="font-size:17px;color:var(--gold)"></i>
          <span class="rp-header-title">Live research &amp; contribution</span>
          <span class="rp-header-sub">Current frontiers</span>
        </div>
        <div class="rp-body">
          <div style="font-size:12px;color:var(--text-muted);margin-bottom:12px">Active research areas related to your symptoms — explore, read, and contribute.</div>
          ${data.research_topics.map((t, i) => `
            <div class="research-item">
              <div class="ri-icon ${icons[i%3]}"><i class="ti ${iconClass[i%3]}"></i></div>
              <div style="flex:1">
                <div class="ri-title" onclick="window.open('https://pubmed.ncbi.nlm.nih.gov/?term=${encodeURIComponent(t)}&sort=date','_blank')">${t}</div>
                <div class="ri-desc">Active research area — latest publications and open peer review</div>
                <div class="ri-links">
                  <span class="ri-link" onclick="window.open('https://pubmed.ncbi.nlm.nih.gov/?term=${encodeURIComponent(t)}&sort=date','_blank')"><i class="ti ti-search" style="font-size:11px"></i>PubMed</span>
                  <span class="ri-link" onclick="window.open('https://www.medrxiv.org/search/${encodeURIComponent(t)}','_blank')"><i class="ti ti-file-text" style="font-size:11px"></i>medRxiv</span>
                  <span class="ri-link" onclick="window.open('https://www.cochranelibrary.com/search?searchBy=6&searchText=${encodeURIComponent(t)}','_blank')"><i class="ti ti-clipboard-list" style="font-size:11px"></i>Cochrane</span>
                  <span class="ri-link" onclick="window.open('https://scholar.google.com/scholar?q=${encodeURIComponent(t)}','_blank')"><i class="ti ti-brand-google" style="font-size:11px"></i>Scholar</span>
                </div>
              </div>
            </div>`).join('')}
          <div class="contribute-strip">
